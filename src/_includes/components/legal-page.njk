{#- The body of a privacy policy or terms page, in the Moonquake brand. Set `legalTitle` before
    including. `backUrl` overrides the /apps/<slug>/ breadcrumb. LOOM needs it: its permalink is
    /loom/, not /apps/loom/, so the default would put two 404s on its legal pages. -#}
{%- set appUrl = backUrl or ("/apps/" + slug + "/") -%}
<style>
{% include "components/moonquake-prose.njk" %}
  .mq-legal { padding: 56px 0 96px; }
  .mq-legal-col { max-width: 720px; }
  .mq-legal-back { font-size: 12px; }
  .mq-legal-back:hover { color: var(--mq-regolith); text-decoration: none; }
  .mq-legal h1 { margin: 40px 0 0; font-size: clamp(36px, 6vw, 52px); font-weight: 500; letter-spacing: -0.04em; line-height: 1.05; }
  .mq-legal-updated { margin-top: 14px; font-size: 12px; }
  .mq-legal .highlight-box { margin: 36px 0 40px; }
  @media (max-width: 639px) { .mq-legal { padding: 40px 0 72px; } }
</style>

<main id="main-content" class="mq-legal">
  <div class="mq-wrap">
    <div class="mq-legal-col">
      <nav aria-label="Breadcrumb">
        <a href="{{ appUrl }}" class="mq-legal-back mq-label">&larr; Back to {{ appName }}</a>
      </nav>

      <h1>{{ legalTitle }}</h1>
      <p class="mq-legal-updated mq-label">Last updated {{ lastUpdated }}</p>

      <div class="mq-prose">
        <div class="highlight-box" role="note">
          <p><strong>Summary:</strong> {{ summary }}</p>
        </div>
        <article>
          {{ content | safe }}
        </article>
      </div>
    </div>
  </div>
</main>
