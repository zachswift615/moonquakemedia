{#- The Listen2 brand (brand/README.md in the Listen2 repo) laid over layouts/moonquake.njk, for the pages
    that belong to Listen2: its user guide and the blog posts tagged "listen2". Set `listen2Brand: true` on
    a page to use it. It only re-points the Moonquake tokens and fonts, so every component those layouts
    style (prose, guide sections, callouts, toolbars) follows without its own copy. Included INSIDE a
    <style> block, after the Moonquake rules. -#}
  {% include "components/listen2-fonts.njk" %}
  :root {
    --mq-night: #0B0B0C;      /* Night */
    --mq-regolith: #F5F5F2;   /* Paper */
    --mq-basalt: #2A2A2D;     /* Border */
    --mq-edge: #3A3A3D;
    --mq-dust: #A3A3A0;       /* Mist: 7.8:1 on Night */
    --mq-mist: #D4D4D0;
    --mq-signal: #FF751F;     /* Spine Orange, the action color */
    --mq-mono: 'Atkinson Hyperlegible Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --l2-link: #38B6FF;       /* Page Blue, wordmark and links */
  }
  body { font-family: 'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  .mq-prose { color: #E4E4E0; }
  .mq-prose a { color: var(--l2-link); text-decoration-color: rgba(56, 182, 255, 0.45); }
  .mq-prose a:hover { text-decoration-color: var(--l2-link); }
  :focus-visible { outline-color: var(--l2-link); }

  /* Nav lockup: the Listen2 mark and wordmark in place of the Moonquake ones. */
  .l2-brand { display: flex; align-items: center; gap: 10px; color: var(--l2-link); }
  .l2-brand:hover { color: var(--l2-link); text-decoration: none; }
  .l2-brand img { width: 36px; height: auto; display: block; }
  .l2-wordmark { font-size: 22px; font-weight: 500; letter-spacing: -0.01em; line-height: 1; }
  .l2-wordmark span { color: #FFCC00; }
  .mq-links a { min-height: 44px; display: inline-flex; align-items: center; }
  .l2-get { padding: 0 16px; border-radius: 22px; background: var(--mq-signal); color: #111113 !important; font-weight: 700; }
  .l2-get:hover { color: #111113 !important; text-decoration: none; filter: brightness(1.05); }
