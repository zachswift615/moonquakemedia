{#- Listen2 2.0 draft styles, included inside the layout's <style> block. Values come from the Listen2 brand
    tokens (brand/tokens.json): Night #0B0B0C, Surface #131315, Border #2A2A2D, Paper #F5F5F2, Mist #A3A3A0,
    Voice Pink #FF66C4, Offline Green #7ED957, dark highlight #006E99, radius sm 12 / md 20 / highlight 3.
    The Confirm tag is a "worth checking" state, so it uses the warning role (Caution Amber #FFA31F on its dark
    surface #2D200F, with words and an icon). Nothing here animates; any motion added later follows the kit's
    motion rule (0.1 s / 0.2 s / 0.32 s, ease-in-out, a cross-fade under Reduce Motion). -#}
.l2-slot{margin:0;display:flex;flex-direction:column;gap:8px;min-width:0}
.l2-slot-name{font-size:16px;font-weight:700;color:#F5F5F2}
.l2-slot-tag,.l2-slot-label{font-family:'Atkinson Hyperlegible Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:#A3A3A0}
.l2-slot-tag{margin-left:6px;white-space:nowrap}
.l2-slot audio{width:100%;min-height:44px}
.l2-slot-box{border:2px dashed #2A2A2D;border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;gap:4px;min-height:44px;justify-content:center}
.l2-slot-box code{font-family:'Atkinson Hyperlegible Mono',ui-monospace,monospace;font-size:13px;color:#FF66C4;overflow-wrap:anywhere}
.l2-slot-box--screen{height:100%;box-sizing:border-box;border-radius:40px;padding:24px;font-size:15px;line-height:1.45;color:#A3A3A0;text-align:center;align-items:center}
.l2-phone{flex:0 0 auto;max-width:100%;aspect-ratio:1320 / 2868;box-sizing:border-box;padding:9px;border-radius:48px;background:#1C1C1E;border:1px solid #3A3A3D}
.l2-confirm{display:inline-flex;align-items:center;gap:6px;margin:0 4px;padding:2px 8px;border-radius:9999px;border:1px dashed #FFA31F;background:#2D200F;font-family:'Atkinson Hyperlegible Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:0.04em;color:#FFA31F;vertical-align:middle;line-height:1.5}
.l2-confirm::before{content:"!";flex:0 0 auto;width:14px;height:14px;border-radius:7px;background:#FFA31F;color:#111113;font-weight:700;font-size:10px;line-height:14px;text-align:center}
.l2-tag{display:inline-flex;align-items:center;gap:8px;padding:4px 12px;border-radius:9999px;font-size:14px;font-weight:700;text-decoration:none}
.l2-tag::before{content:"";width:8px;height:8px;border-radius:4px;background:currentColor}
.l2-tag--pink{background:rgba(255,102,196,0.14);color:#FF66C4}
.l2-tag--green{background:rgba(126,217,87,0.14);color:#7ED957}
.l2-hl{background:#006E99;color:#FFFFFF;border-radius:3px;padding:0 4px}
.l2-steps{margin:0;padding:0;list-style:none;counter-reset:l2step;display:flex;flex-direction:column;gap:16px}
.l2-steps li{counter-increment:l2step;display:grid;grid-template-columns:40px 1fr;gap:4px 14px;font-size:17px;line-height:1.55;color:#A3A3A0}
.l2-steps li::before{content:counter(l2step);grid-row:span 2;width:40px;height:40px;border-radius:20px;border:2px solid #FF66C4;color:#FF66C4;font-weight:700;display:flex;align-items:center;justify-content:center}
.l2-steps strong{color:#F5F5F2;font-size:18px}
.l2-measured summary{font-size:18px;font-weight:700;padding:10px 0;display:block;color:#F5F5F2}
.l2-measured p,.l2-measured li{font-size:16px;line-height:1.6;color:#A3A3A0}
.l2-players{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.l2-player{display:flex;align-items:center;gap:14px;padding:12px 16px 12px 12px;border:1px solid #2A2A2D;border-radius:20px;background:#131315;min-width:0}
.l2-player.is-playing{border-color:#FF66C4}
.l2-play{flex:0 0 auto;width:48px;height:48px;border-radius:24px;border:0;padding:0;background:#FF751F;display:flex;align-items:center;justify-content:center;cursor:pointer}
.l2-play:focus-visible{outline:2px solid #38B6FF;outline-offset:3px}
.l2-play .l2-ico-pause,.l2-player.is-playing .l2-play .l2-ico-play{display:none}
.l2-player.is-playing .l2-play .l2-ico-pause{display:block}
.l2-pbody{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:8px}
.l2-pname{font-size:17px;font-weight:700;color:#F5F5F2;line-height:1.3}
.l2-pname .l2-slot-tag{margin-left:4px}
.l2-pbody audio{width:100%;min-height:44px}
.l2-wave{height:28px;display:flex;align-items:center;gap:2px;cursor:pointer}
.l2-wave[hidden]{display:none}
.l2-wave i{flex:1 1 0;max-width:4px;min-height:3px;border-radius:2px;background:rgba(255,102,196,0.32);transition:background-color 0.1s ease-in-out}
.l2-wave i.on{background:#FF66C4}
.l2-ptime{flex:0 0 auto;font-family:'Atkinson Hyperlegible Mono',ui-monospace,monospace;font-size:13px;font-weight:500;letter-spacing:0.08em;color:#A3A3A0}
@media (prefers-reduced-motion: reduce){.l2-wave i{transition:none}}
.l2-key{width:100%;border-collapse:collapse;font-size:15px;line-height:1.45}
.l2-key th{text-align:left;font-family:'Atkinson Hyperlegible Mono',ui-monospace,monospace;font-size:12px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:#A3A3A0;padding:6px 12px 6px 0;border-bottom:1px solid #2A2A2D}
.l2-key td{padding:6px 12px 6px 0;border-bottom:1px solid #1E1E21;color:#A3A3A0;vertical-align:top}
.l2-key td:first-child{font-family:'Atkinson Hyperlegible Mono',ui-monospace,monospace;font-weight:500;color:#F5F5F2;white-space:nowrap}
.l2-key td:nth-child(2){color:#FF66C4;white-space:nowrap}
.l2-keys{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px 40px;margin-top:16px}
