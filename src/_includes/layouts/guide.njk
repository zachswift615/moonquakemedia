---
layout: layouts/moonquake.njk
---
{#- A user guide under /guides/<slug>/. Brand chrome from layouts/moonquake.njk, reading styles from
    components/moonquake-prose.njk. The guide's own pieces (sections, callout boxes, button labels,
    screenshots, the version and download menus) are styled in src/css/main.css, since
    assets/guide-export.js reads the same class names to build the .docx, PDF and EPUB. -#}
{# ── Version data lookup ── #}
{% set versions = guideVersions[slug] if guideVersions and guideVersions[slug] else [] %}
{% set currentStatus = null %}
{% set latestVersionSlug = null %}
{% for v in versions %}
  {% if v.version == guideVersion %}{% set currentStatus = v.status %}{% endif %}
  {% if v.status == "latest" %}{% set latestVersionSlug = v.version %}{% endif %}
{% endfor %}

<style>
{% include "components/moonquake-prose.njk" %}
  .mq-guide-head { padding: 64px 0 40px; }
  .mq-guide-head h1 { margin: 18px 0 0; font-size: clamp(36px, 6vw, 56px); font-weight: 500; letter-spacing: -0.04em; line-height: 1.04; }
  .mq-guide-head h1 .font-brand { letter-spacing: -0.02em; }
  .mq-guide-head p { margin: 14px 0 0; font-size: 18px; color: var(--mq-mist); }
  .mq-guide-body { max-width: 760px; padding: 48px 0 96px; }
  .mq-guide-notices { max-width: 760px; padding-top: 32px; display: grid; gap: 12px; }
  .guide-notice { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px;
    border: 1px solid var(--mq-edge); border-radius: 4px; background: rgba(42, 44, 51, 0.35); }
  .guide-notice-icon { width: 20px; height: 20px; flex: none; margin-top: 2px; color: var(--mq-mist); stroke-width: 1.75; }
  .guide-notice h2 { margin: 0; font-size: 16px; font-weight: 500; }
  .guide-notice p { margin: 4px 0 0; font-size: 15px; color: var(--mq-mist); }
  .guide-notice a { color: var(--mq-regolith); text-decoration: underline; text-decoration-color: var(--mq-edge); text-underline-offset: 3px; }
  .guide-notice-alert { border-left: 2px solid var(--mq-signal); }
  .guide-notice-alert .guide-notice-icon { color: var(--mq-signal); }
  .guide-notice-meta { font-family: var(--mq-mono); font-size: 12px !important; color: var(--mq-dust) !important; }
  @media (max-width: 639px) { .mq-guide-head { padding: 48px 0 32px; } }
</style>

<header class="mq-guide-head">
    <div class="mq-wrap">
        <div class="mq-label">User guide</div>
        <h1><span class="{% if brandFont %}font-brand{% endif %}">{{ title }}</span> User Guide</h1>
        <p>{{ subtitle | default("Your Complete Guide") }}</p>
    </div>
</header>

{# ── Back link, version selector, download ── #}
<nav class="guide-toolbar" aria-label="Guide tools">
    <div class="mq-wrap guide-toolbar-row">
        <div class="flex items-center gap-3 min-w-0">
            <a href="/apps/{{ slug }}/" class="guide-back mq-label whitespace-nowrap">&larr; <span class="hidden sm:inline">Back to </span>{{ title }}</a>
            {% if versions | length > 0 %}
            <div class="relative" id="version-selector">
                <button id="version-btn"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls="version-menu"
                        aria-label="Guide version: {{ guideVersion }}{% if currentStatus == 'latest' %}, latest release{% elif currentStatus == 'beta' %}, beta pre-release{% elif currentStatus == 'legacy' %}, archived version{% endif %}"
                        class="version-selector-btn">
                    <span aria-hidden="true">{{ guideVersion }}</span>
                    {% if currentStatus == "latest" %}<span class="version-badge version-badge-latest" aria-hidden="true">Latest</span>
                    {% elif currentStatus == "beta" %}<span class="version-badge version-badge-beta" aria-hidden="true">Beta</span>
                    {% elif currentStatus == "legacy" %}<span class="version-badge version-badge-legacy" aria-hidden="true">Legacy</span>
                    {% endif %}
                    <span aria-hidden="true">&#9662;</span>
                </button>
                <ul id="version-menu" role="menu" aria-label="Switch guide version" hidden class="version-menu">
                    {% for v in versions %}
                    <li role="none">
                        <a href="/guides/{{ slug }}/{{ v.version }}/"
                           role="menuitem"
                           tabindex="-1"
                           aria-current="{% if v.version == guideVersion %}page{% else %}false{% endif %}"
                           class="version-menu-item{% if v.version == guideVersion %} version-menu-item-active{% endif %}">
                            <span class="version-menu-label">{{ v.label }}</span>
                            {% if v.status == "latest" %}<span class="version-badge version-badge-latest"><span class="sr-only">(</span>Latest<span class="sr-only">)</span></span>
                            {% elif v.status == "beta" %}<span class="version-badge version-badge-beta"><span class="sr-only">(</span>Beta<span class="sr-only">)</span></span>
                            {% elif v.status == "legacy" %}<span class="version-badge version-badge-legacy"><span class="sr-only">(</span>Legacy<span class="sr-only">)</span></span>
                            {% endif %}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        </div>
        <div class="relative">
            <button id="guide-download-btn"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="guide-download-menu"
                    aria-live="polite"
                    class="guide-download-btn">
                Download <span class="hidden sm:inline">Guide </span><span aria-hidden="true">&#9662;</span>
            </button>
            <div id="guide-download-menu" role="menu" aria-label="Export formats" hidden class="guide-download-menu">
                <button role="menuitem" data-format="docx" tabindex="-1">
                    <span class="guide-download-format">Word Document (.docx)</span>
                    <span class="guide-download-desc">For editing and review</span>
                </button>
                <button role="menuitem" data-format="pdf" tabindex="-1">
                    <span class="guide-download-format">PDF</span>
                    <span class="guide-download-desc">For reading and printing</span>
                </button>
                <button role="menuitem" data-format="epub" tabindex="-1">
                    <span class="guide-download-format">EPUB</span>
                    <span class="guide-download-desc">For reading in Listen2 or ebook apps</span>
                </button>
            </div>
        </div>
    </div>
</nav>

{# ── Version status banners ── #}
{% if currentStatus == "beta" or currentStatus == "legacy" or iapNotice %}
<div class="mq-wrap">
<div class="mq-guide-notices">
{% if currentStatus == "beta" %}
<div class="guide-notice" role="note">
    {% icon "flask-conical", "guide-notice-icon" %}
    <div>
        <h2>Beta documentation</h2>
        <p>You're viewing the guide for a pre-release version. Content may change before the final release.
            {% if latestVersionSlug %}<a href="/guides/{{ slug }}/{{ latestVersionSlug }}/">View the current stable guide &rarr;</a>{% endif %}
        </p>
    </div>
</div>
{% endif %}
{% if currentStatus == "legacy" %}
<div class="guide-notice" role="note">
    {% icon "archive", "guide-notice-icon" %}
    <div>
        <h2>Archived documentation</h2>
        <p>This guide is for an older version and may not reflect the current app.
            {% if latestVersionSlug %}<a href="/guides/{{ slug }}/{{ latestVersionSlug }}/">View the current guide &rarr;</a>{% endif %}
        </p>
    </div>
</div>
{% endif %}
{% if iapNotice %}
<div class="guide-notice guide-notice-alert" role="note">
    {% icon "alert-triangle", "guide-notice-icon" %}
    <div>
        <h2>{{ iapNotice.title }}</h2>
        <p>{{ iapNotice.message }}</p>
        <p class="guide-notice-meta">{{ iapNotice.updated }}</p>
    </div>
</div>
{% endif %}
</div>
</div>
{% endif %}

<div class="mq-wrap">
<main id="main-content" class="mq-prose mq-guide-body"{% if guideVersion %} data-guide-version="{{ guideVersion }}"{% endif %}>
    {% if toc and toc.length %}
    <div class="content-section guide-toc">
        <h2>Table of Contents</h2>
        <ol>
            {% for section in toc %}
            <li><a href="#{{ section.id }}">{{ section.title }}</a></li>
            {% endfor %}
        </ol>
    </div>
    {% endif %}

    {{ content | safe }}
</main>
</div>

<script defer src="https://cdn.jsdelivr.net/npm/docx@9/build/index.umd.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/jspdf@latest/dist/jspdf.umd.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/jszip@latest/dist/jszip.min.js"></script>
<script defer src="/assets/guide-export.js"></script>

{% if versions | length > 0 %}
<script>
(function() {
  var btn = document.getElementById('version-btn');
  var menu = document.getElementById('version-menu');
  if (!btn || !menu) return;

  var items = Array.from(menu.querySelectorAll('[role="menuitem"]'));

  function openMenu() {
    menu.hidden = false;
    btn.setAttribute('aria-expanded', 'true');
    // Focus the current-page item, or the first item
    var current = menu.querySelector('[aria-current="page"]') || items[0];
    if (current) current.focus();
  }

  function closeMenu(restoreFocus) {
    menu.hidden = true;
    btn.setAttribute('aria-expanded', 'false');
    if (restoreFocus) btn.focus();
  }

  btn.addEventListener('click', function(e) {
    e.stopPropagation();
    menu.hidden ? openMenu() : closeMenu(true);
  });

  btn.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      openMenu();
    }
  });

  menu.addEventListener('keydown', function(e) {
    var idx = items.indexOf(document.activeElement);
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      items[(idx + 1) % items.length].focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      items[(idx - 1 + items.length) % items.length].focus();
    } else if (e.key === 'Home') {
      e.preventDefault();
      items[0].focus();
    } else if (e.key === 'End') {
      e.preventDefault();
      items[items.length - 1].focus();
    } else if (e.key === 'Escape') {
      e.preventDefault();
      closeMenu(true);
    } else if (e.key === 'Tab') {
      closeMenu(false);
    }
  });

  document.addEventListener('click', function(e) {
    if (!menu.hidden && !menu.contains(e.target) && e.target !== btn) {
      closeMenu(false);
    }
  });
})();
</script>
{% endif %}
