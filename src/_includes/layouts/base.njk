<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {#- `seoTitle` is the whole <title>, with no site-name suffix, for pages whose search title is
        written to fit the ~60 characters a result shows. Everything else keeps "Title | Site". #}
    {%- set fullTitle = seoTitle or ((title + " | " if title else "") + site.name) %}
    <title>{{ fullTitle }}</title>
    {% if description %}
    <meta name="description" content="{{ description }}">
    {% endif %}

    <!-- Apple Smart App Banner -->
    {% if appStoreId != false %}<meta name="apple-itunes-app" content="app-id={{ appStoreId or '6755753624' }}">{% endif %}

    <!-- Open Graph -->
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content="{{ ogTitle or fullTitle }}">
    <meta property="og:description" content="{{ ogDescription or description or site.tagline }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ ogImage or '/images/og-default.png' }}">
    {% if ogImageWidth %}<meta property="og:image:width" content="{{ ogImageWidth }}">
    <meta property="og:image:height" content="{{ ogImageHeight }}">{% endif %}
    {% if ogImageAlt %}<meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ogTitle or fullTitle }}">
    <meta name="twitter:description" content="{{ ogDescription or description or site.tagline }}">
    <meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/images/og-default.png' }}">
    {% if ogImageAlt %}<meta name="twitter:image:alt" content="{{ ogImageAlt }}">{% endif %}

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="pWAcs0monFAO6yO10RzsFqi0N_AsM7VPJNnKKpAUy0s">

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <!-- Article metadata -->
    {% if date and ogType == "article" %}
    <meta property="article:published_time" content="{{ date | isoDate }}">
    {% endif %}
    {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
    {% if themeColor %}<meta name="theme-color" content="{{ themeColor }}">{% endif %}

    <!-- Favicon -->
    {#- The defaults are the Moonquake mark. A page that brings its own icon sets all three, since a
        browser that reads SVG favicons takes the SVG over any PNG. #}
    <link rel="icon" type="image/svg+xml" href="{{ faviconSvg or '/images/favicon.svg' }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ favicon or '/images/favicon-32.png' }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ favicon16 or '/images/favicon-16.png' }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ appleTouchIcon or '/images/apple-touch-icon.png' }}">

    {% block head %}{% endblock %}

    {% if not selfHostedFonts %}<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">{% endif %}
    <link rel="stylesheet" href="/css/main.css">
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Blog" href="/blog/feed.xml">
    {% include "components/site-jsonld.njk" %}
</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-7BTNSTLZL4"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-7BTNSTLZL4');

  // Call-to-action clicks, matched by where the link goes rather than by marking each button, so a
  // CTA added to any page later (including a link in a blog post's Markdown) is counted without
  // anyone remembering to tag it. `link_location` is the nearest section id, or "page".
  (function () {
    var rules = [
      [/\.dmg(\?|#|$)/i, 'trial_download'],
      [/^\/loom\/buy\/?$|buy\.polar\.sh/i, 'buy_click'],
      [/\/redeem(\?|#|$)/i, 'claim_licence_click'],
      [/youtube\.com\/watch|youtu\.be\//i, 'video_click'],
      [/\/LOOM-keyboard-shortcuts-[a-z]+\.pdf$/i, 'shortcuts_pdf_click']
    ];
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a) return;
      var url = new URL(a.href, location.href);
      var target = url.host === location.host ? url.pathname : url.href;
      for (var i = 0; i < rules.length; i++) {
        if (rules[i][0].test(target)) {
          var section = a.closest('[id]');
          gtag('event', rules[i][1], {
            link_url: url.href,
            link_text: (a.textContent || '').trim().slice(0, 100),
            link_location: section ? section.id : 'page'
          });
          return;
        }
      }
    }, true);
  })();
</script>
<body class="{% block bodyClass %}{% endblock %}">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {% block content %}{{ content | safe }}{% endblock %}

    {% block footer %}
    {% if not ownFooter %}{% include "components/footer.njk" %}{% endif %}
    {% endblock %}

    {% block scripts %}{% endblock %}
</body>
</html>
