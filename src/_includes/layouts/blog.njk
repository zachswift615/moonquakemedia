---
layout: layouts/moonquake.njk
ogType: article
rss: true
navLinks:
  - { text: LOOM, url: /loom/ }
  - { text: Listen2, url: /apps/listen2/ }
---
<style>
  .mq-article { padding: 80px 0 96px; }
  .mq-article-col { max-width: 680px; }
  .mq-article-meta { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 12px; }
  .mq-article h1 {
    margin: 18px 0 0; font-size: clamp(32px, 5.2vw, 48px); font-weight: 500;
    letter-spacing: -0.035em; line-height: 1.08; text-wrap: balance;
  }

{% include "components/moonquake-prose.njk" %}
  .mq-article .mq-prose { margin-top: 48px; }

  .mq-article-foot { margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--mq-basalt); }
  .mq-article-foot a { font-size: 12px; }
  .mq-article-foot a:hover { color: var(--mq-regolith); text-decoration: none; }

  @media (max-width: 639px) {
    .mq-article { padding: 56px 0 72px; }
  }
</style>

<main id="main-content" class="mq-article">
  <div class="mq-wrap">
    <article class="mq-article-col">
      <header>
        <div class="mq-article-meta mq-label">
          <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{{ content | readingTime }}</span>
        </div>
        <h1>{{ title }}</h1>
      </header>

      <div class="mq-prose">
        {{ content | safe }}
      </div>

      {%- if "loom" in (tags or []) %}
      <div style="margin-top:56px;">
        {%- set signupSource = "blog" %}
        {% include "components/loom-signup.njk" %}
      </div>
      {%- endif %}

      <footer class="mq-article-foot">
        <a href="/blog/" class="mq-label">&larr; All posts</a>
      </footer>
    </article>
  </div>
</main>
{%- set faq = content | faqFromHtml %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "{{ site.url }}{{ page.url }}#post",
      "headline": {{ title | dump | safe }},
      "description": {{ (description or excerpt or "") | dump | safe }},
      "url": "{{ site.url }}{{ page.url }}",
      "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
      "datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ (updated or date) | isoDate }}",
      "image": "{{ site.url }}{{ ogImage or '/images/og-default.png' }}",
      "inLanguage": "en",
      "keywords": {{ (tags or []) | reject("equalto", "blog") | join(", ") | dump | safe }},
      "author": { "@id": "{{ site.url }}/#organization" },
      "publisher": { "@id": "{{ site.url }}/#organization" },
      "isPartOf": { "@id": "{{ site.url }}/#website" }
      {%- if "loom" in (tags or []) %},
      "about": { "@id": "{{ site.url }}/loom/#software" }
      {%- endif %}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{ site.name }}", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.url }}/blog/" },
        { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
      ]
    }
    {%- if faq.length %},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in faq %}
        { "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    {%- endif %}
  ]
}
</script>
