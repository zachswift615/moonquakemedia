              <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.13em;color:#8A9099;">not coming back</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:0;border-top:1px solid #23262C;">
              
                <div style="padding:11px 0;border-bottom:1px solid #1A1D22;font-size:15px;line-height:1.45;color:#C7CDD4;">A record-arm step</div>
              
