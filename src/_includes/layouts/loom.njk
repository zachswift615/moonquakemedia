{#
  LOOM landing page.

  Authored as a design and exported as static HTML; this layout is that
  export carried across into the site's build, the same way the Listen2
  page is a bespoke layout under _includes/layouts/. The page's content
  file is src/apps/loom.md, which sets the /loom/ permalink.

  Four things changed on the way in, and nothing else:
    1. assets/*.png            -> /assets/loom/*.png
    2. the content container   -> <main id="main-content">, so base.njk's
                                  skip-link has a target
    3. the Google Fonts <link> -> @font-face on self-hosted woff2 below
    4. the four href="#" links -> inert, visibly not-yet-live controls.
                                  Grep LOOM-LINK-PENDING.

  If the design changes, re-export and regenerate rather than editing
  this file by hand — otherwise the two versions drift.
#}
<style>
  /* ------------------------------------------------------------------
     LOOM landing page — self-hosted webfonts.

     The design was authored against fonts.googleapis.com. The site self-
     hosts its webfonts instead (see the Space Grotesk face in
     src/css/main.css), so these are the same two families served from
     /assets/fonts/. Both are variable fonts: one file covers the whole
     weight range the design uses (Archivo 400-700, JetBrains Mono
     400-700). Licences sit beside them as *-OFL.txt.
     ------------------------------------------------------------------ */
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 400 700;
    font-stretch: 100%;
    font-display: swap;
    src: url('/assets/fonts/archivo-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 400 700;
    font-stretch: 100%;
    font-display: swap;
    src: url('/assets/fonts/archivo-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/assets/fonts/jetbrains-mono-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/assets/fonts/jetbrains-mono-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  /* The design's own base rules, carried across from the export verbatim.
     They come after /css/main.css in the cascade, so they win where the
     site's Tailwind base layer would otherwise reach this page. */
  html, body { margin: 0; padding: 0; background: #0B0C0E; }
  body { font-family: Archivo, "Helvetica Neue", Helvetica, Arial, sans-serif; }
  a { color: #4CC9F0; text-decoration: none; }
  a:hover { color: #8AD9F5; text-decoration: underline; }
  *:focus-visible { outline: 2px solid #7FDBFF; outline-offset: 2px; }
  img { max-width: 100%; }

  /* The site footer (components/footer.njk) lands on this page's dark
     ground, as it does on the Listen2 page. */
  body > footer { color: #6B7078; }
</style>

<div style="background:#0B0C0E;color:#E8EAED;font-family:Archivo,sans-serif;-webkit-font-smoothing:antialiased;">

  <div style="position:sticky;top:0;z-index:20;background:rgba(11,12,14,0.92);backdrop-filter:blur(12px);border-bottom:1px solid #23262C;">
    <div style="max-width:1240px;margin:0 auto;padding:14px 32px;display:flex;align-items:center;gap:14px;">
      <img src="/assets/loom/loom-icon.png" alt="" style="width:30px;height:30px;border-radius:7px;display:block;flex:none;">
      <div style="font-size:19px;font-weight:700;letter-spacing:0.02em;flex:none;">LOOM</div>
      <div style="flex:1;min-width:0;"></div>
      <div style="display:flex;align-items:center;gap:26px;">
        <a href="#arrange" style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.13em;color:#C7CDD4;">ARRANGE</a>
        <a href="#mixer" style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.13em;color:#C7CDD4;">MIXER</a>
        <a href="#record" style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.13em;color:#C7CDD4;">RECORD</a>
        <a href="#get" style="padding:9px 20px;border-radius:6px;background:#4CC9F0;color:#08090B;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;letter-spacing:0.1em;">GET LOOM</a>
      </div>
    </div>
  </div>

  <main id="main-content" style="max-width:1240px;margin:0 auto;padding:0 32px;">

    <div style="padding:104px 0 0;display:flex;flex-direction:column;gap:34px;">
      <div style="display:flex;align-items:center;gap:12px;">
        <div style="width:7px;height:7px;border-radius:2px;background:#35D07F;flex:none;"></div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:12.5px;letter-spacing:0.2em;color:#8A9099;">LIVE LOOPING INSTRUMENT · MACOS</div>
      </div>
      <h1 style="margin:0;font-size:clamp(46px,6.4vw,88px);font-weight:700;letter-spacing:-0.035em;line-height:0.98;max-width:15ch;text-wrap:balance;">A loop station that plays itself.</h1>
      <p style="margin:0;font-size:clamp(18px,2vw,23px);line-height:1.5;color:#C7CDD4;max-width:60ch;text-wrap:pretty;">Record and overdub on five tracks the way you would on a hardware looper. Then draw those same commands on a timeline, and the song presses its own buttons while you play. One engine underneath both, so nothing you learn at the loop station stops being true in the arrangement.</p>
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;">
        <!-- ⛔ LINKED STRAIGHT OUT TO GITHUB RELEASES, AND DELIBERATELY NOT THROUGH A REDIRECT
     ON THIS DOMAIN. GitHub Pages is static, so a /loom/download hop could only be a meta-refresh
     page — strictly worse than an anchor, for no gain: unlike /loom/buy, this URL is not compiled
     into any shipped binary, so there is nothing to protect from becoming unchangeable. The
     `latest/download/LOOM.dmg` form resolves to the newest release forever, which is why
     publishing a version needs no edit here. -->
        <a href="{{ releases.latestDmgUrl }}" style="padding:15px 28px;border-radius:8px;background:#35D07F;color:#08090B;font-family:'JetBrains Mono',monospace;font-size:13.5px;font-weight:700;letter-spacing:0.09em;">DOWNLOAD FOR MACOS</a>
        <!-- ⛔ /loom/buy AND NOT THE POLAR URL. That path is `loom::licence::kPurchaseUrl`,
     compiled into every shipped binary and unchangeable for a copy already sold, so it is the
     one place in the world that names the merchant. Pointing this button at Polar directly
     would leave that redirect exercised only by the in-app button — a path nobody tests until
     it is broken. See src/loom-buy.njk. -->
        <a href="/loom/buy" style="padding:15px 28px;border-radius:8px;background:#171A1F;border:1px solid #2C3038;color:#E8EAED;font-family:'JetBrains Mono',monospace;font-size:13.5px;font-weight:700;letter-spacing:0.09em;">BUY A LICENCE</a>
        <!-- ⭐ THE VERSION IS ALWAYS LABELLED "LATEST" AND IS NEVER A CHOICE HERE. Both download
             buttons resolve to releases/latest/download, so what this line names is exactly what
             the button gives you — it comes from the same `releases` data, read from the GitHub
             Releases API at build time, so the page cannot advertise a version it does not ship.
             Older builds exist and have permanent addresses, but they live on /loom/version where
             somebody has gone looking for them. Nobody should have to decide which LOOM to
             download on the page whose job is to give them LOOM. -->
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;line-height:1.6;color:#8A9099;">Latest ({{ releases.latest.version }}) · {{ releases.latest.dmgSize }} · 14-day trial<br>Apple Silicon · macOS 13.3+ · <a href="/loom/version">all versions</a></div>
      </div>
    </div>

    <div style="padding:64px 0 0;">
      <div style="border:1px solid #23262C;border-radius:12px;overflow:hidden;background:#101216;box-shadow:0 40px 120px rgba(0,0,0,0.7);">
        <!-- SCREENSHOTS: captured 2026-09-19, off ~/Desktop/loom-screenshots-2026-09-19.
             The four originals keep their shot-*.png names rather than the capture names,
             because loom.md's `ogImage` points at shot-looper.png and social platforms cache
             an og:image by URL — a rename would orphan every card already scraped. The
             mapping, for the next refresh:
               shot-looper.png       <- loop-view.png
               shot-arrange.png      <- arrange-view-automation.png
               shot-eq.png           <- mixer-eq-effect.png
               shot-delay.png        <- mixer-delay-effect-sync-options.png
               shot-amp.png          <- mixer-amp-effect.png        (new this refresh)
               shot-racks.png        <- effect-rack-presets.png     (new this refresh)
               shot-record-setup.png <- record-setup.png            (new this refresh)
               shot-chorus.png       <- mixer-chorus-effect.png     (copied in, not placed)
               shot-presets.png      <- effect-presets.png          (copied in, not placed)
             ⚠️ EVERY ALT HERE MAKES A COUNTABLE CLAIM — "six bands", "thirteen divisions",
             "ten files" — so each was read off the new image before this commit rather than
             carried across. An alt that describes the previous build is worse than a stale
             screenshot: the screenshot is merely old, the alt is untrue, and the only reader
             who gets the untrue one is the reader who cannot see the image. -->
        <img src="/assets/loom/shot-looper.png" alt="LOOM looper view: five track rings reading REC, DUB, PLAY, STOPPED and EMPTY, the track panel open on track 1, and the notice row reading that ten files are being recorded" style="width:100%;height:auto;display:block;">
      </div>
      <div style="padding:14px 2px 0;font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.1em;color:#8A9099;">LOOPER · FIVE TRACKS · THE RING SAYS WHAT THE NEXT PRESS DOES</div>
    </div>

    <div style="padding:112px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;">
      
        <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:26px 24px 28px;display:flex;flex-direction:column;gap:10px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#FF4438;">ONE PRESS</div>
          <div style="font-size:17px;font-weight:600;letter-spacing:-0.01em;line-height:1.25;">No arming, ever</div>
          <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">The ring’s centre says what the next press will do. There is no record-arm step and no separate play button — both are on record as decisions.</div>
        </div>
      
        <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:26px 24px 28px;display:flex;flex-direction:column;gap:10px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#FFB020;">THE GRID FOLLOWS YOU</div>
          <div style="font-size:17px;font-weight:600;letter-spacing:-0.01em;line-height:1.25;">Your first loop sets the tempo</div>
          <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Close a free-length loop with quantize off and LOOM derives the tempo from what you played, while the transport rolls, with nothing extra pressed.</div>
        </div>
      
        <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:26px 24px 28px;display:flex;flex-direction:column;gap:10px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#35D07F;">TWELVE STATES</div>
          <div style="font-size:17px;font-weight:600;letter-spacing:-0.01em;line-height:1.25;">Never colour alone</div>
          <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Every ring phase has its own arc treatment, and a wedge marks a command that is scheduled and has not happened yet.</div>
        </div>
      
        <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:26px 24px 28px;display:flex;flex-direction:column;gap:10px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#4CC9F0;">TO THE SAMPLE</div>
          <div style="font-size:17px;font-weight:600;letter-spacing:-0.01em;line-height:1.25;">One engine, two routes</div>
          <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">The loop station and the arrangement drive the same engine, so a region fires exactly what your hands would have.</div>
        </div>
      
    </div>

    <div style="padding:128px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:56px;align-items:start;">
      <div style="display:flex;flex-direction:column;gap:20px;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#8A9099;">THE GAP</div>
        <h2 style="margin:0;font-size:clamp(30px,3.4vw,42px);font-weight:700;letter-spacing:-0.025em;line-height:1.08;text-wrap:balance;">The software that did this is gone.</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:18px;">
        <p style="margin:0;font-size:17.5px;line-height:1.6;color:#C7CDD4;text-wrap:pretty;">There was a program that did this once — an arrangement that performs a looper — and it is not sold or maintained any more. Everything else asks you to choose: the immediacy of a loop pedal, or the structure of a timeline.</p>
        <p style="margin:0;font-size:17.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">LOOM aims at that gap without giving up the hardware-looper flow to get there. Press the ring and it records — there is no arm step, and there never will be. Draw the same command on a lane and it fires on its own tick, to the sample.</p>
      </div>
    </div>

    <div id="arrange" style="scroll-margin-top:88px;padding:128px 0 0;display:flex;flex-direction:column;gap:32px;">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:74ch;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#4CC9F0;">ARRANGE</div>
        <h2 style="margin:0;font-size:clamp(32px,3.8vw,50px);font-weight:700;letter-spacing:-0.03em;line-height:1.05;text-wrap:balance;">Draw the performance. Play over it.</h2>
        <p style="margin:0;font-size:18.5px;line-height:1.55;color:#C7CDD4;text-wrap:pretty;">Regions on a track's lane, three verbs: <span style="font-family:'JetBrains Mono',monospace;font-size:16px;color:#FF4438;">REC</span>, <span style="font-family:'JetBrains Mono',monospace;font-size:16px;color:#FFB020;">DUB</span>, <span style="font-family:'JetBrains Mono',monospace;font-size:16px;color:#35D07F;">PLAY</span>. A gap means the track is stopped, so you never draw a stop — LOOM synthesises it at the region's end. This is the half a hardware looper cannot do.</p>
        <p style="margin:0;font-size:18.5px;line-height:1.55;color:#C7CDD4;text-wrap:pretty;">Under the regions, automation lanes move the desk. A fader, a pan, a mute, any control on any effect — and a node that drops a whole saved rack into a chain, named on the lane so the song reads as a row of passages.</p>
      </div>
      <div style="border:1px solid #23262C;border-radius:12px;overflow:hidden;background:#101216;box-shadow:0 40px 120px rgba(0,0,0,0.7);">
        <img src="/assets/loom/shot-arrange.png" alt="LOOM arrange view: thirteen regions across five track lanes, with automation lanes underneath — two FX 2 send levels, a main level, a pan, and two rack preset lanes whose bands are named Nasty Acoust G2B, Chorus Delay AC and Clean ACG" style="width:100%;height:auto;display:block;">
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:28px;padding-top:8px;">
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">Perform from the top, or from here</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Play the whole arrangement from bar 1, or from wherever you put the playhead. STOP stays live throughout.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">Mouse or keyboard, fully</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Drag a body to move, an edge to trim, past the window edge to scroll under it. ⌘Z steps the arrangement’s own undo, and one drag is one step even when it shoved three neighbours aside.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">Eleven zoom steps</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">8 to 224 pixels per bar, all zooming about the pointer, plus FIT and a FOLLOW toggle for whether the view chases the playhead.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #A78BFA;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">Automate the desk, not just the loops</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">A strip’s level on any of its four fader axes, its pan, its mute, an effect slot’s bypass, and every control on every effect you have put in a slot.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #A78BFA;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">A node can load a whole rack</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Drop a saved preset into one slot, or a saved rack across a whole chain, at the bar you put it on. The band that follows carries the name in force.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #A78BFA;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">A lane holds values, not a reference</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">The node takes a copy of the entry’s settings, so a song you performed last month sounds the way it sounded whatever you have done to your library since.</div>
          </div>
        
      </div>
    </div>

    <div style="padding:120px 0 0;">
      <div style="border:1px solid #3A2320;border-radius:14px;background:linear-gradient(180deg,#15100F,#0F1114);padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:22px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:3px;height:19px;background:#FF4438;flex:none;border-radius:1px;"></div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#FF6A5E;">ALL OR NOTHING</div>
        </div>
        <h2 style="margin:0;font-size:clamp(28px,3.4vw,44px);font-weight:700;letter-spacing:-0.03em;line-height:1.06;max-width:24ch;text-wrap:balance;">It tells you before it plays.</h2>
        <p style="margin:0;font-size:18px;line-height:1.6;color:#C7CDD4;max-width:66ch;text-wrap:pretty;">If any region in the arrangement cannot be played correctly, nothing starts. The notice row says why — one line per bad region, each a full sentence that leads with what to change rather than an error code.</p>
        <p style="margin:0;font-size:16.5px;line-height:1.6;color:#8A9099;max-width:66ch;text-wrap:pretty;">The alternative most software picks is to play seven of your eight regions and drop the eighth silently. You find out from the audience.</p>
      </div>
    </div>

    <div id="mixer" style="scroll-margin-top:88px;padding:128px 0 0;display:flex;flex-direction:column;gap:32px;">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:74ch;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#A78BFA;">MIXER &amp; EFFECTS</div>
        <h2 style="margin:0;font-size:clamp(32px,3.8vw,50px);font-weight:700;letter-spacing:-0.03em;line-height:1.05;text-wrap:balance;">A real desk behind the loops.</h2>
        <p style="margin:0;font-size:18.5px;line-height:1.55;color:#C7CDD4;text-wrap:pretty;">Four banks off one switch — loop tracks, inputs, master, buses. Eight insert slots on every strip, and every chain runs in stereo on every placement. Chains save with the song.</p>
        <p style="margin:0;font-size:18.5px;line-height:1.55;color:#C7CDD4;text-wrap:pretty;">Nine effects to put in them: parametric EQ, compressor, delay, reverb, noise gate, chorus, octave, cab and a guitar amp. Save one slot as a preset or a whole chain as a rack, and the arrangement can load either while you play.</p>
      </div>
      <div style="border:1px solid #23262C;border-radius:12px;overflow:hidden;background:#101216;box-shadow:0 40px 120px rgba(0,0,0,0.7);">
        <img src="/assets/loom/shot-eq.png" alt="LOOM mixer with the effect drawer open on a parametric EQ: the response curve drawn over a live spectrum, six bands from a high pass to a low pass, cut at 300 Hz and lifted above 3 kHz, in a chain loaded from the Vocal Air rack" style="width:100%;height:auto;display:block;">
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
        <div style="border:1px solid #23262C;border-radius:10px;overflow:hidden;background:#101216;">
          <img src="/assets/loom/shot-delay.png" alt="LOOM effect drawer open on a delay, third in a chain after a parametric EQ and a compressor, showing thirteen beat divisions from 1⁄1 down to 1⁄16T with 1⁄8 selected" style="width:100%;height:auto;display:block;">
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;justify-content:center;">
          
            <div style="display:flex;gap:14px;align-items:flex-start;">
              <div style="width:6px;height:6px;border-radius:2px;background:#A78BFA;flex:none;margin-top:8px;"></div>
              <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:5px;">
                <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">Nine effects, six-band EQ</div>
                <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">EQ with a live spectrum behind the curve, a compressor drawing its transfer curve, reverb, a ping-pong delay that locks to the beat, a noise gate, chorus, octave, cab and amp.</div>
              </div>
            </div>
          
            <div style="display:flex;gap:14px;align-items:flex-start;">
              <div style="width:6px;height:6px;border-radius:2px;background:#4CC9F0;flex:none;margin-top:8px;"></div>
              <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:5px;">
                <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">One faders row, four destinations</div>
                <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">MAIN, CUE, FX 1, FX 2 — whichever is selected, every fader in the rack is addressing it. No per-strip send knob to hunt for.</div>
              </div>
            </div>
          
            <div style="display:flex;gap:14px;align-items:flex-start;">
              <div style="width:6px;height:6px;border-radius:2px;background:#35D07F;flex:none;margin-top:8px;"></div>
              <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:5px;">
                <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">Three buses, and where sound leaves by</div>
                <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">CUE tapped pre-fader so a strip pulled down for the room stays in your headphones. An OUTPUT picker on every bus and the master.</div>
              </div>
            </div>
          
            <div style="display:flex;gap:14px;align-items:flex-start;">
              <div style="width:6px;height:6px;border-radius:2px;background:#FFB020;flex:none;margin-top:8px;"></div>
              <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:5px;">
                <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">Typed values, honest refusals</div>
                <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Every parameter takes a typed value as well as a drag, and a value outside the range is refused by name rather than quietly rounded.</div>
              </div>
            </div>
          
            <div style="display:flex;gap:14px;align-items:flex-start;">
              <div style="width:6px;height:6px;border-radius:2px;background:#E04AC1;flex:none;margin-top:8px;"></div>
              <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:5px;">
                <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">The delay can lock to the beat</div>
                <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Switch it from FREE to SYNC, pick a division, and it follows the song’s tempo. A division too long for the delay line is drawn dimmed rather than silently clamped.</div>
              </div>
            </div>
          
        </div>
      </div>
    </div>

    <div style="padding:128px 0 0;display:flex;flex-direction:column;gap:32px;">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:74ch;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#A78BFA;">PRESETS &amp; RACKS</div>
        <h2 style="margin:0;font-size:clamp(32px,3.8vw,50px);font-weight:700;letter-spacing:-0.03em;line-height:1.05;text-wrap:balance;">Save a sound. Recall it mid-song.</h2>
        <p style="margin:0;font-size:18.5px;line-height:1.55;color:#C7CDD4;text-wrap:pretty;">A preset is one effect’s settings. A rack is a whole chain — which effect is in each slot, every setting, and which slots are bypassed. LOOM ships a library of both and keeps yours beside them. Loading a rack replaces the chain in one step, and ⌘Z takes it back.</p>
      </div>
      <div style="border:1px solid #23262C;border-radius:12px;overflow:hidden;background:#101216;box-shadow:0 40px 120px rgba(0,0,0,0.7);">
        <img src="/assets/loom/shot-racks.png" alt="LOOM’s rack browser over the mixer, listing factory racks named Vocal Air, Guitar Ambient, Drum Glue, Acoustic Stage, G2B, Bass DI, Pad Wash, Octave Lead and Wide Clean, each with a row of slot chips naming the effects in it, above the performer’s own saved racks" style="width:100%;height:auto;display:block;">
      </div>
      <div style="padding:4px 2px 0;font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.1em;color:#8A9099;">THE RACK BROWSER · FACTORY AND YOUR OWN · LOAD REPLACES THE CHAIN IN ONE STEP</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;padding-top:24px;">
        <div style="border:1px solid #23262C;border-radius:12px;overflow:hidden;background:#101216;">
          <img src="/assets/loom/shot-amp.png" alt="LOOM effect drawer open on the guitar amp: CLEAN, CRUNCH and HIGH GAIN models, gain and tight controls, a bass, mid, treble and presence tone stack, and a 4x12 closed cab, second in a chain after a noise gate" style="width:100%;height:auto;display:block;">
        </div>
        <div style="border:1px solid #23262C;border-radius:12px;overflow:hidden;background:#101216;">
          <img src="/assets/loom/shot-chorus.png" alt="LOOM effect drawer open on the chorus: rate, depth, a sine or triangle shape, one to four voices, and four stereo constructions — offset, split, opposed and mono — third in a chain after an amp" style="width:100%;height:auto;display:block;">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:28px;padding-top:8px;">
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">The bar tells you where you stand</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">EDITED when a setting has moved, FACTORY on one that ships with LOOM, AUTOMATED when a lane is driving it, OVERRIDE when you have picked a different one by hand mid-performance.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">A chain has its own undo</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">⌘Z steps the effect chain you are working in, separately from the arrangement’s stack, and one gesture is one step even when it moved every slot.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">A swap fades, it does not click</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Changing the effect in a slot while the chain is running fades over 50 ms and waits for the fade to finish, so a rack change mid-song is a dip rather than a pop.</div>
          </div>
        
      </div>
    </div>

    <div id="record" style="scroll-margin-top:88px;padding:128px 0 0;display:flex;flex-direction:column;gap:32px;">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:74ch;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#FF4438;">PERFORMANCE RECORDING</div>
        <h2 style="margin:0;font-size:clamp(32px,3.8vw,50px);font-weight:700;letter-spacing:-0.03em;line-height:1.05;text-wrap:balance;">Play the set. Mix it later.</h2>
        <p style="margin:0;font-size:18.5px;line-height:1.55;color:#C7CDD4;text-wrap:pretty;">RECORD on the transport writes your whole performance as separate WAV files — each loop track on its own, each effects bus on its own, the main mix, and groups you build yourself out of live inputs or out of tracks and buses. Every file starts at the same moment and stays in step, so the folder drops straight into a DAW and lines up at zero.</p>
        <p style="margin:0;font-size:17px;line-height:1.6;color:#8A9099;text-wrap:pretty;">This is on top of the takes in the song, not instead of them. Play the whole thing once, then balance it against a video, or re-process a guitar that was too loud in the room, without asking the audience for another take.</p>
      </div>
      <div style="border:1px solid #23262C;border-radius:12px;overflow:hidden;background:#101216;box-shadow:0 40px 120px rgba(0,0,0,0.7);">
        <img src="/assets/loom/shot-record-setup.png" alt="LOOM’s Record setup sheet: five loop tracks and two effects buses ticked, the CUE bus left off, ten files per recording at 3.84 MB/s, and a panel working out the disk cost and the hours of room left" style="width:100%;height:auto;display:block;">
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:28px;padding-top:8px;">
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">You choose what goes in which file</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">A group sums the sources you tick into one stereo file. Live inputs in one, loop tracks and buses in another — LOOM keeps them apart because the two line up at different moments.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">It says what it will cost first</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Megabytes per second, files per recording, free space, and how many hours of room that is — before you press anything, not after the disk fills.</div>
          </div>
        
          <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid #23262C;padding-top:16px;">
            <div style="font-size:16px;font-weight:600;letter-spacing:-0.01em;">A dropout is written down</div>
            <div style="font-size:14.5px;line-height:1.55;color:#8A9099;text-wrap:pretty;">If the disk cannot keep up, the gap is filled with silence in every file at once so they stay in step, and its time and length go into a Markers.txt you can read in any editor.</div>
          </div>
        
      </div>
    </div>

    <div style="padding:128px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:48px;align-items:center;">
      <div style="display:flex;flex-direction:column;gap:20px;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#35D07F;">OFFLINE BY CONSTRUCTION</div>
        <h2 style="margin:0;font-size:clamp(30px,3.6vw,46px);font-weight:700;letter-spacing:-0.03em;line-height:1.05;text-wrap:balance;">The venue's WiFi is not your problem.</h2>
        <p style="margin:0;font-size:17.5px;line-height:1.6;color:#C7CDD4;text-wrap:pretty;">LOOM opens no connection, sends no request and reads nothing back. Not on launch, not on a schedule, not to check a licence, not to fetch a font. No account, no activation server, nothing reporting home. Your licence is verified on your own Mac.</p>
        <p style="margin:0;font-size:16px;line-height:1.6;color:#8A9099;text-wrap:pretty;">A build check enforces it: no code LOOM writes reaches a network entry point, and the check fails the build if any does. Two buttons hand an address to your browser — buying a licence, and looking up the latest version. That is the whole of it.</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px;background:#23262C;border:1px solid #23262C;border-radius:12px;overflow:hidden;">
        
          <div style="background:#0F1114;padding:22px 20px;display:flex;flex-direction:column;gap:6px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:#35D07F;">0</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.13em;line-height:1.5;color:#8A9099;">ACCOUNTS TO MAKE</div>
          </div>
        
          <div style="background:#0F1114;padding:22px 20px;display:flex;flex-direction:column;gap:6px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:#35D07F;">0</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.13em;line-height:1.5;color:#8A9099;">ACTIVATION SERVERS</div>
          </div>
        
          <div style="background:#0F1114;padding:22px 20px;display:flex;flex-direction:column;gap:6px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:#35D07F;">0</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.13em;line-height:1.5;color:#8A9099;">REQUESTS SENT</div>
          </div>
        
          <div style="background:#0F1114;padding:22px 20px;display:flex;flex-direction:column;gap:6px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:#35D07F;">0</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.13em;line-height:1.5;color:#8A9099;">TELEMETRY</div>
          </div>
        
          <div style="background:#0F1114;padding:22px 20px;display:flex;flex-direction:column;gap:6px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:#35D07F;">0</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.13em;line-height:1.5;color:#8A9099;">SEATS TO DEAUTHORISE</div>
          </div>
        
          <div style="background:#0F1114;padding:22px 20px;display:flex;flex-direction:column;gap:6px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:#35D07F;">1</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.13em;line-height:1.5;color:#8A9099;">FILE ON YOUR DISK</div>
          </div>
        
      </div>
    </div>

    <div style="padding:128px 0 0;display:flex;flex-direction:column;gap:40px;">
      <div style="display:flex;flex-direction:column;gap:16px;max-width:70ch;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#8A9099;">EVERYTHING ELSE IT DOES</div>
        <h2 style="margin:0;font-size:clamp(30px,3.6vw,46px);font-weight:700;letter-spacing:-0.03em;line-height:1.05;text-wrap:balance;">Built for the twenty minutes you are on stage.</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;">
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#FF4438;">LOOPING</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">Five tracks, quantized both ways</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">Launch on immediate, next beat, next bar or next cycle; stop on immediate, end of beat, bar or loop — per track and as a song default. Pre-set lengths to 32 bars, and a fixed recording closes itself.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#FFB020;">LAYERS</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">Sum or replace, undo on every track</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">SUM keeps every layer, REPLACE overwrites under the pass. One layer of undo and redo per track, independent of the arrangement’s own stack.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#35D07F;">MONITORING</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">You hear yourself immediately</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">Input 1 is audible at launch, everything else starts muted, and nothing has to be armed — or even to exist — for that to be true.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#4CC9F0;">INPUTS</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">Pan into the take, stereo links</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">An input’s pan is recorded, not just monitored. Link inputs 1, 3, 5 or 7 to the one after it and the pair becomes one strip with one chain across both channels.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#A78BFA;">YOUR FILES</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">Every pass is a WAV you can open</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">32-bit float, two-channel, at your interface’s sample rate, written when the pass closes with no save step. Songs are folders in ~/Music/LOOM, and performance recordings are folders beside them.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#FF4438;">HARDWARE</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">Change interface mid-session</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">No relaunch. Your routing is captured and restored across the change, and LOOM warns you first when a track still holds audio — counting the loss in the heading.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#FFB020;">WHEN IT SPEAKS</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">One notice row, and it remembers</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">The same height whether it holds a two-line refusal or nothing, so nothing on screen moves. LOG opens everything LOOM told you this session, selectable and copyable.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#35D07F;">ACCESSIBILITY</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">Keyboard-complete, and it talks</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">A self-test walks the live window and fails the build unless every command control is named and reachable. The notice line and the focused track’s phase are announced, on one switch you can silence for a set.</div>
          </div>
        
          <div style="background:#0F1114;border:1px solid #23262C;border-radius:12px;padding:28px 26px 30px;display:flex;flex-direction:column;gap:11px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.18em;color:#4CC9F0;">THE MANUAL</div>
            <div style="font-size:17.5px;font-weight:600;letter-spacing:-0.015em;line-height:1.25;">Inside the app, as a PDF</div>
            <div style="font-size:14.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">⌘? opens it. No network call — it is on your machine, so it is there on a stage, behind a captive portal, and at two in the morning.</div>
          </div>
        
      </div>
    </div>

    <div style="padding:120px 0 0;">
      <div style="border:1px solid #23262C;border-radius:14px;background:#0F1114;padding:clamp(30px,3.6vw,48px);display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:start;">
        <div style="display:flex;flex-direction:column;gap:16px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#A78BFA;">MIDI, PRECISELY</div>
          <h3 style="margin:0;font-size:clamp(24px,2.6vw,32px);font-weight:700;letter-spacing:-0.025em;line-height:1.1;">A pedalboard drives the whole instrument.</h3>
          <p style="margin:0;font-size:16.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">Every track has its own octave with the same seven commands in the same order, and the global verbs have an octave of their own. The map starts at note 36, so a 49-key controller reaches the first four tracks with nothing transposed. A live monitor on the bottom rail shows the last message received, in every view, so you can answer <em style="color:#C7CDD4;font-style:normal;">is LOOM seeing my controller</em> without leaving what you are doing.</p>
          <p style="margin:0;font-size:15.5px;line-height:1.6;color:#8A9099;text-wrap:pretty;">The map is compiled in. There is no MIDI learn, no binding editor and no way to reassign a note — that is on the roadmap, not in this version. Notes only: CC is displayed and bound to nothing, and there is no clock, MTC or MMC in or out.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:2px;background:#23262C;border:1px solid #23262C;border-radius:8px;overflow:hidden;">
          
            <div style="background:#121418;padding:12px 16px;display:flex;align-items:center;gap:14px;">
              <div style="font-family:'JetBrains Mono',monospace;font-size:12.5px;letter-spacing:0.06em;color:#C7CDD4;flex:1;min-width:0;">TRACK 1</div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:12.5px;font-weight:700;color:#C7CDD4;flex:none;">36 – 42</div>
            </div>
          
            <div style="background:#121418;padding:12px 16px;display:flex;align-items:center;gap:14px;">
