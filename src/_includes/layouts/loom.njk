    <!-- FAQ. The questions and answers are src/_data/loomFaq.js, which also feeds the FAQPage
         structured data at the foot of this file, so the visible answer and the one search
         engines read are the same sentence. -->
    <div id="faq" style="scroll-margin-top:88px;padding:128px 0 0;display:flex;flex-direction:column;gap:32px;">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:74ch;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#8A9099;">QUESTIONS</div>
        <h2 style="margin:0;font-size:clamp(30px,3.6vw,46px);font-weight:700;letter-spacing:-0.03em;line-height:1.05;text-wrap:balance;">Before you download.</h2>
      </div>
      <div style="display:flex;flex-direction:column;border-top:1px solid #23262C;">
        {%- for item in loomFaq %}
        <details style="border-bottom:1px solid #23262C;padding:0;">
          <summary style="cursor:pointer;padding:20px 2px;font-size:17.5px;font-weight:600;letter-spacing:-0.01em;line-height:1.35;"><h3 style="display:inline;margin:0;font-size:inherit;font-weight:inherit;">{{ item.q }}</h3></summary>
          <div style="padding:0 2px 22px;max-width:74ch;font-size:16px;line-height:1.6;color:#8A9099;text-wrap:pretty;">{{ item.a }}{% if item.link %} <a href="{{ item.link.href }}">{{ item.link.text }}</a>.{% endif %}</div>
        </details>
        {%- endfor %}
      </div>
    </div>

    <div id="get" style="scroll-margin-top:88px;padding:128px 0 0;display:flex;flex-direction:column;gap:36px;">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:62ch;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.2em;color:#35D07F;">GET LOOM</div>
        <h2 style="margin:0;font-size:clamp(32px,4vw,54px);font-weight:700;letter-spacing:-0.03em;line-height:1.02;text-wrap:balance;">Fourteen days, everything unlocked.</h2>
        <p style="margin:0;font-size:18px;line-height:1.6;color:#C7CDD4;text-wrap:pretty;">No watermarks, no session limits, no account. When the trial’s up, your licence is a small file you open once. LOOM checks it on your Mac at launch and never again, so a licence check will never interrupt you mid-set.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:20px;">
        <div style="border:1px solid #2C3038;border-radius:12px;background:linear-gradient(180deg,#12201A,#0F1114);padding:30px 28px;display:flex;flex-direction:column;gap:16px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;color:#35D07F;">STEP ONE</div>
          <h3 style="margin:0;font-size:21px;font-weight:600;letter-spacing:-0.02em;">Download and play</h3>
          <div style="font-size:15px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Download the disk image, drag LOOM into Applications, and open it from the Applications folder.</div>
          <div style="flex:1;min-height:8px;"></div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.06em;color:#6B7078;">LATEST · {{ releases.latest.version }} · {{ releases.latest.dmgSize }}</div>
          <!-- Direct to GitHub Releases, for the reason written at the hero button above. -->
          <a href="{{ releases.latestDmgUrl }}" style="padding:14px 0;text-align:center;border-radius:8px;background:#35D07F;color:#08090B;font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;letter-spacing:0.09em;">DOWNLOAD .DMG</a>
        </div>
        <div style="border:1px solid #2C3038;border-radius:12px;background:#0F1114;padding:30px 28px;display:flex;flex-direction:column;gap:16px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;color:#4CC9F0;">STEP TWO</div>
          <h3 style="margin:0;font-size:21px;font-weight:600;letter-spacing:-0.02em;">Buy a licence</h3>
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.06em;color:#C7CDD4;">{% include "components/loom-price.njk" %}</div>
          <div style="font-size:15px;line-height:1.55;color:#8A9099;text-wrap:pretty;">Checkout is handled by Polar. You’ll get a licence key, which you exchange for your licence file. Hang on to that file: it never expires, and moving to a new Mac is just a matter of copying it over.</div>
          <div style="flex:1;min-height:8px;"></div>
          <!-- /loom/buy, for the reason written at the hero button above. -->
          <a href="/loom/buy" style="padding:14px 0;text-align:center;border-radius:8px;background:#171A1F;border:1px solid #2C3038;color:#E8EAED;font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;letter-spacing:0.09em;">BUY ON POLAR</a>
        </div>
        <div style="border:1px solid #23262C;border-radius:12px;background:#0F1114;padding:30px 28px;display:flex;flex-direction:column;gap:14px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;color:#8A9099;">REQUIREMENTS</div>
          <div style="display:flex;flex-direction:column;gap:0;">
            
              <div style="padding:11px 0;border-bottom:1px solid #1A1D22;display:flex;gap:12px;align-items:baseline;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.13em;color:#8A9099;width:74px;flex:none;">MACOS</div>
                <div style="font-size:14.5px;line-height:1.45;color:#C7CDD4;flex:1;min-width:0;">13.3 Ventura or later</div>
              </div>
            
              <div style="padding:11px 0;border-bottom:1px solid #1A1D22;display:flex;gap:12px;align-items:baseline;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.13em;color:#8A9099;width:74px;flex:none;">CHIP</div>
                <div style="font-size:14.5px;line-height:1.45;color:#C7CDD4;flex:1;min-width:0;">Apple Silicon only (no Intel build)</div>
              </div>
            
              <div style="padding:11px 0;border-bottom:1px solid #1A1D22;display:flex;gap:12px;align-items:baseline;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.13em;color:#8A9099;width:74px;flex:none;">AUDIO</div>
                <div style="font-size:14.5px;line-height:1.45;color:#C7CDD4;flex:1;min-width:0;">An audio interface, or the Mac’s built-in input</div>
              </div>
            
              <div style="padding:11px 0;border-bottom:1px solid #1A1D22;display:flex;gap:12px;align-items:baseline;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.13em;color:#8A9099;width:74px;flex:none;">MIDI</div>
                <div style="font-size:14.5px;line-height:1.45;color:#C7CDD4;flex:1;min-width:0;">Optional: any class-compliant keyboard or pad controller to play the instruments</div>
              </div>
            
              <div style="padding:11px 0;border-bottom:1px solid #1A1D22;display:flex;gap:12px;align-items:baseline;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.13em;color:#8A9099;width:74px;flex:none;">NETWORK</div>
                <div style="font-size:14.5px;line-height:1.45;color:#C7CDD4;flex:1;min-width:0;">Not needed, ever</div>
              </div>
            
              <div style="padding:11px 0;border-bottom:1px solid #1A1D22;display:flex;gap:12px;align-items:baseline;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.13em;color:#8A9099;width:74px;flex:none;">VERSION</div>
                <div style="font-size:14.5px;line-height:1.45;color:#C7CDD4;flex:1;min-width:0;">{{ releases.latest.version }} (<a href="/loom/version">release history</a>)</div>
              </div>
            
          </div>
        </div>
      </div>
      {%- set signupSource = "loom-page" %}
      {% include "components/loom-signup.njk" %}
    </div>

    <div style="padding:112px 0 0;">
      <div style="border-top:1px solid #23262C;padding:34px 0 64px;display:flex;flex-wrap:wrap;gap:24px;align-items:center;">
        <img src="/assets/loom/loom-icon-64.png" alt="" width="26" height="26" style="width:26px;height:26px;border-radius:6px;display:block;flex:none;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;color:#8A9099;">LOOM · <a href="/" style="color:#8A9099;">MOONQUAKE MEDIA</a></div>
        <div style="flex:1;min-width:40px;"></div>
        <!-- ⛔ THIS WAS A LIVE 404. It pointed at a relative licence page, resolving to
             /loom/licence.html, under a note saying the claim page was "a separate piece of
             work" that had not landed. It landed: the licence service is deployed, and the
             page that trades a Polar licence key for the customer's LOOM.loomlicence file is
             /redeem on it. The note outlived the thing it was waiting for.
             It is an absolute URL to the service rather than a path here because the service
             is a different application on a different host. If it ever moves behind
             licence.moonquakemedia.com, this is one of four places that names it — the others
             are Polar's success URL, its webhook and the Custom benefit's note. -->
        <a href="https://web-production-5d00dd.up.railway.app/redeem" style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;">CLAIM YOUR LICENCE</a>
        <a href="/loom/manual/" style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;">MANUAL</a>
        <a href="/loom/version" style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;">VERSIONS</a>
        <a href="/blog/" style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;">BLOG</a>
        <a href="/legal/loom-privacy/" style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;">PRIVACY</a>
        <a href="mailto:support@moonquakemedia.com" style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;">SUPPORT</a>
      </div>
    </div>

  </main>
</div>

<!-- STRUCTURED DATA. The product, its demo video, the breadcrumb and the FAQ, for search engines
     and AI answer engines. Every value comes from the same data the page draws: the version and
     download from `releases`, the price from `loomPricing`, the FAQ from `loomFaq`. The web
     manual's pages point back at "#software" as what they are about. ⛔ No aggregateRating or
     review: LOOM has none yet, and inventing them is a manual-action offence at Google. -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "{{ site.url }}/loom/#software",
      "name": "LOOM",
      "alternateName": "LOOM live looper",
      "description": {{ description | dump | safe }},
      "url": "{{ site.url }}/loom/",
      "applicationCategory": "MultimediaApplication",
      "applicationSubCategory": "Live looper",
      "operatingSystem": "macOS 13.3 or later",
      "processorRequirements": "Apple Silicon",
      "softwareVersion": "{{ releases.latest.version }}",
      "datePublished": "{{ ((releases.older | last) if releases.older.length else releases.latest).publishedAt | isoDate }}",
      "dateModified": "{{ releases.latest.publishedAt | isoDate }}",
      "downloadUrl": "{{ releases.latestDmgUrl }}",
      "installUrl": "{{ releases.latestDmgUrl }}",
      "releaseNotes": "{{ site.url }}/loom/version",
      "softwareHelp": { "@type": "CreativeWork", "url": "{{ site.url }}/loom/manual/" },
      "image": "{{ site.url }}/assets/loom/loom-icon.png",
      "screenshot": [
        "{{ site.url }}/assets/loom/shot-looper.png",
        "{{ site.url }}/assets/loom/shot-arrange.png",
        "{{ site.url }}/assets/loom/shot-synth.png",
        "{{ site.url }}/assets/loom/shot-drums.png",
        "{{ site.url }}/assets/loom/shot-sampler.png",
        "{{ site.url }}/assets/loom/shot-eq.png",
        "{{ site.url }}/assets/loom/shot-tuner.png",
        "{{ site.url }}/assets/loom/shot-record-setup.png"
      ],
      "featureList": [
        "Five audio loop tracks with record, overdub, replace, undo and redo",
        "Four MIDI instrument tracks with a built-in synth, drum machine and sampler",
        "Arrange view: draw REC, DUB and PLAY regions and the song plays the looper",
        "Automation of faders, pans, mutes, effect and instrument parameters, presets and racks",
        "Mixer with eight insert slots per strip, a cue mix and two effects buses",
        "Parametric EQ, compressor, delay, reverb, noise gate, chorus, octave, transparent overdrive, cab, guitar amp, harmony, gain and a tuner",
        "Performance recording to separate synced WAV files",
        "MIDI control of every track and the transport",
        "Fully offline, with no account and no activation server"
      ],
      "isAccessibleForFree": false,
      "offers": {
        "@type": "Offer",
        "price": "{{ loomPricing.price }}",
        "priceCurrency": "{{ loomPricing.currency }}",
        "priceValidUntil": "{{ loomPricing.priceValidUntil }}",
        "availability": "https://schema.org/InStock",
        "url": "{{ site.url }}/loom/buy",
        "seller": { "@id": "{{ site.url }}/#organization" }
      },
      "publisher": { "@id": "{{ site.url }}/#organization" },
      "author": { "@id": "{{ site.url }}/#organization" },
      "subjectOf": { "@id": "{{ site.url }}/loom/#demo" }
    },
    {
      "@type": "VideoObject",
      "@id": "{{ site.url }}/loom/#demo",
      "name": "LOOM Arrange View Demo",
      "description": "A demo of LOOM, live looping software for macOS whose arrange view automates the button presses of traditional looping.",
      "thumbnailUrl": "{{ site.url }}/assets/loom/demo-poster.jpg",
      "uploadDate": "2026-09-20T03:00:33-07:00",
      "duration": "PT1M55S",
      "contentUrl": "https://www.youtube.com/watch?v=sngb7h791C4",
      "embedUrl": "https://www.youtube-nocookie.com/embed/sngb7h791C4",
      "publisher": { "@id": "{{ site.url }}/#organization" }
    },
    {
      "@type": "VideoObject",
      "@id": "{{ site.url }}/loom/#overview",
      "name": "LOOM 1.3 for Mac: A Live Looper That Plays Itself (Full Overview)",
      "description": "A 31-minute overview of LOOM, a live looper for Apple Silicon Macs: the looper view, the built-in drum machine, synth and sampler, the arrange view that runs the looper for you, the mixer and effects, and recording a performance as synced stems.",
      "thumbnailUrl": "{{ site.url }}/assets/loom/overview-poster.jpg",
      "uploadDate": "2026-10-07",
      "duration": "PT31M16S",
      "contentUrl": "https://www.youtube.com/watch?v=se70SNu-5nA",
      "embedUrl": "https://www.youtube-nocookie.com/embed/se70SNu-5nA",
      "publisher": { "@id": "{{ site.url }}/#organization" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{ site.name }}", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "LOOM", "item": "{{ site.url }}/loom/" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "{{ site.url }}/loom/#faq",
      "mainEntity": [
        {%- for item in loomFaq %}
        {
          "@type": "Question",
          "name": {{ item.q | dump | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
  ]
}
</script>
