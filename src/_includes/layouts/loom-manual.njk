---
layout: layouts/base.njk
---
{#
  The web manual: /loom/manual/ and one page per chapter under it.

  The chapter bodies are generated by scripts/sync-loom-manual.py from LOOM's own manual renderer,
  so this layout only frames them: the LOOM header, a chapter list, previous and next, and the
  structured data. Search titles and descriptions come from loom-manual.11tydata.js.
#}
{%- set chapters = loomManual.chapters %}
{%- set here = chapter.order if chapter else 0 %}
{%- set prev = null %}{% set next = null %}
{%- for c in chapters %}
  {%- if c.order == here - 1 %}{% set prev = c %}{% endif %}
  {%- if c.order == here + 1 %}{% set next = c %}{% endif %}
{%- endfor %}
{%- if not chapter %}{% set next = chapters[0] %}{% endif %}
<style>
  {% include "components/loom-fonts.njk" %}

  html, body { margin: 0; padding: 0; background: #0B0C0E; }
  body { font-family: Archivo, "Helvetica Neue", Helvetica, Arial, sans-serif; color: #E8EAED;
         -webkit-font-smoothing: antialiased; }
  a { color: #4CC9F0; text-decoration: none; }
  a:hover { color: #8AD9F5; text-decoration: underline; }
  *:focus-visible { outline: 2px solid #7FDBFF; outline-offset: 2px; }
  body > footer { color: #6B7078; }

  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .lm-bar { position: sticky; top: 0; z-index: 20; background: rgba(11,12,14,0.92);
            backdrop-filter: blur(12px); border-bottom: 1px solid #23262C; }
  .lm-bar-in { max-width: 1240px; margin: 0 auto; padding: 14px 32px; display: flex;
               align-items: center; gap: 14px; }
  .lm-brand { display: flex; align-items: center; gap: 12px; color: #E8EAED; font-size: 19px;
              font-weight: 700; letter-spacing: 0.02em; }
  .lm-brand:hover { color: #E8EAED; text-decoration: none; }
  .lm-brand img { width: 30px; height: 30px; border-radius: 7px; display: block; }
  .lm-link { font-size: 12px; letter-spacing: 0.13em; color: #C7CDD4; }
  .lm-get { padding: 9px 20px; border-radius: 6px; background: #4CC9F0; color: #08090B;
            font-size: 12px; font-weight: 700; letter-spacing: 0.1em; }
  .lm-get:hover { color: #08090B; text-decoration: none; background: #8AD9F5; }

  .lm-wrap { max-width: 1240px; margin: 0 auto; padding: 0 32px; display: grid;
             grid-template-columns: 250px minmax(0, 1fr); gap: 56px; }
  .lm-side { position: sticky; top: 76px; align-self: start; max-height: calc(100vh - 96px);
             overflow-y: auto; padding: 40px 0; }
  .lm-side ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column;
                gap: 2px; }
  .lm-side a { display: block; padding: 7px 10px; border-radius: 6px; font-size: 14px;
               line-height: 1.35; color: #8A9099; }
  .lm-side a:hover { color: #E8EAED; background: #14171B; text-decoration: none; }
  .lm-side a[aria-current="page"] { color: #E8EAED; background: #171A1F; }
  .lm-side-label { font-size: 11px; letter-spacing: 0.18em; color: #6B7078; margin: 0 0 12px 10px; }
  .lm-mobile-toc { display: none; }

  .lm-main { padding: 40px 0 96px; min-width: 0; max-width: 780px; }
  .lm-crumbs { font-size: 11.5px; letter-spacing: 0.1em; color: #6B7078; margin: 0 0 28px; }
  .lm-crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .lm-crumbs li + li::before { content: "/"; margin-right: 8px; color: #3A3F47; }
  .lm-crumbs a { color: #8A9099; }
  .lm-eyebrow { font-size: 12px; letter-spacing: 0.2em; color: #4CC9F0; margin: 0 0 14px; }
  .lm-main h1 { margin: 0 0 28px; font-size: clamp(32px, 4vw, 48px); font-weight: 700;
                letter-spacing: -0.03em; line-height: 1.05; text-wrap: balance; }

  .manual-prose { font-size: 17px; line-height: 1.65; color: #C7CDD4; }
  .manual-prose p, .manual-prose ul, .manual-prose ol, .manual-prose pre, .manual-prose table,
  .manual-prose blockquote { margin: 0 0 18px; }
  .manual-prose h2 { margin: 48px 0 14px; font-size: 26px; font-weight: 700; color: #E8EAED;
                     letter-spacing: -0.02em; line-height: 1.2; scroll-margin-top: 88px; }
  .manual-prose h3 { margin: 32px 0 10px; font-size: 19px; font-weight: 600; color: #E8EAED;
                     line-height: 1.3; scroll-margin-top: 88px; }
  .manual-prose h4 { margin: 24px 0 8px; font-size: 16px; font-weight: 600; color: #E8EAED;
                     scroll-margin-top: 88px; }
  .manual-prose h1, .manual-prose h2, .manual-prose h3, .manual-prose h4 { clear: both; }
  .manual-prose strong { color: #E8EAED; }
  .manual-prose ul, .manual-prose ol { padding-left: 24px; }
  .manual-prose li { margin: 4px 0; }
  .manual-prose code { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.84em;
                       background: #171A1F; border: 1px solid #23262C; padding: 1px 5px;
                       border-radius: 4px; color: #E8EAED; }
  .manual-prose pre { background: #101216; border: 1px solid #23262C; border-radius: 8px;
                      padding: 14px 16px; overflow-x: auto; }
  .manual-prose pre code { background: none; border: 0; padding: 0; }
  .manual-prose table { display: block; overflow-x: auto; border-collapse: collapse;
                        font-size: 15px; }
  .manual-prose th, .manual-prose td { text-align: left; vertical-align: top; padding: 9px 12px;
                                       border-bottom: 1px solid #23262C; }
  .manual-prose th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em;
                     color: #8A9099; background: #101216; }
  .manual-prose td code { white-space: nowrap; }
  .manual-prose blockquote { border-left: 3px solid #2C3038; padding-left: 16px; color: #8A9099; }
  .manual-prose hr { border: 0; border-top: 1px solid #23262C; margin: 36px 0; }

  /* The screenshots. Layout names come from LOOM's renderer (SHOT_LAYOUTS); each image carries
     its own CSS size, half its pixel size, so `step` crops sit at the scale of the UI. */
  .manual-prose figure.shot { margin: 22px 0 28px; }
  .manual-prose figure.shot img { display: block; max-width: 100%; height: auto;
                                  border: 1px solid #2C3038; border-radius: 6px; }
  .manual-prose figure.shot figcaption { font-size: 13.5px; line-height: 1.5; color: #8A9099;
                                         margin-top: 8px; }
  .manual-prose figure.shot-full img { width: 100%; }
  .manual-prose figure.shot-half { max-width: 60%; }
  .manual-prose figure.shot-beside { float: right; width: 40%; margin: 4px 0 18px 28px; }
  .manual-prose figure.shot-beside img { margin: 0 auto; max-height: 520px; width: auto; }
  .manual-prose figure.shot-beside figcaption { text-align: center; }
  .manual-prose div.shot-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
                                margin: 22px 0 28px; }
  .manual-prose div.shot-pair figure.shot { margin: 0; }
  .manual-prose figure.shot-pair img { width: 100%; }

  .manual-toc { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 10px;
                counter-reset: ch; }
  .manual-toc a { display: grid; gap: 6px; padding: 18px 20px; background: #0F1114;
                  border: 1px solid #23262C; border-radius: 10px; }
  .manual-toc a:hover { border-color: #3A3F47; text-decoration: none; }
  .manual-toc-title { color: #E8EAED; font-size: 17px; font-weight: 600; }
  .manual-toc-desc { color: #8A9099; font-size: 14.5px; line-height: 1.5; }

  .lm-pn { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 56px; clear: both; }
  .lm-pn a { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px;
             border: 1px solid #23262C; border-radius: 10px; background: #0F1114; }
  .lm-pn a:hover { border-color: #3A3F47; text-decoration: none; }
  .lm-pn .k { font-size: 11px; letter-spacing: 0.16em; color: #6B7078; }
  .lm-pn .t { color: #E8EAED; font-weight: 600; }
  .lm-pn .next { text-align: right; grid-column: 2; }

  .lm-cta { margin-top: 28px; padding: 24px 26px; border: 1px solid #2C3038; border-radius: 12px;
            background: linear-gradient(180deg, #12201A, #0F1114); display: flex; flex-wrap: wrap;
            align-items: center; gap: 18px; clear: both; }
  .lm-cta p { margin: 0; flex: 1 1 320px; font-size: 15.5px; line-height: 1.55; color: #C7CDD4; }
  .lm-cta a { padding: 12px 22px; border-radius: 8px; background: #35D07F; color: #08090B;
              font-size: 13px; font-weight: 700; letter-spacing: 0.09em; }
  .lm-cta a:hover { color: #08090B; text-decoration: none; background: #5EDC99; }

  @media (max-width: 900px) {
    .lm-wrap { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .lm-side { display: none; }
    .lm-mobile-toc { display: block; margin: 0 0 28px; border: 1px solid #23262C;
                     border-radius: 10px; background: #0F1114; }
    .lm-mobile-toc summary { cursor: pointer; padding: 12px 16px; font-size: 12px;
                             letter-spacing: 0.14em; color: #C7CDD4; }
    .lm-mobile-toc ol { list-style: none; margin: 0; padding: 0 8px 10px; }
    .lm-mobile-toc a { display: block; padding: 8px; font-size: 15px; color: #8A9099; }
    .manual-prose figure.shot-beside { float: none; width: auto; margin: 22px 0 28px; }
    .manual-prose figure.shot-half { max-width: 100%; }
  }
  @media (max-width: 600px) {
    .lm-bar-in, .lm-wrap { padding-left: 16px; padding-right: 16px; }
    .lm-link { display: none; }
    .manual-prose div.shot-pair { grid-template-columns: 1fr; }
  }
</style>

<header class="lm-bar">
  <div class="lm-bar-in">
    <a href="/loom/" class="lm-brand"><img src="/assets/loom/loom-icon-64.png" alt="" width="30" height="30">LOOM</a>
    <div style="flex:1;min-width:0;"></div>
    <nav aria-label="LOOM" style="display:flex;align-items:center;gap:26px;">
      <a href="/loom/manual/" class="lm-link mono"{% if not chapter %} aria-current="page"{% endif %}>MANUAL</a>
      <a href="/loom/version" class="lm-link mono">VERSIONS</a>
      <a href="/loom/#get" class="lm-get mono">GET LOOM</a>
    </nav>
  </div>
</header>

<div class="lm-wrap">
  <nav class="lm-side" aria-label="Manual chapters">
    <p class="lm-side-label mono">LOOM {{ loomManual.version }} MANUAL</p>
    <ol>
      {%- for c in chapters %}
      <li><a href="{{ c.url }}"{% if c.order == here %} aria-current="page"{% endif %}>{{ c.title }}</a></li>
      {%- endfor %}
    </ol>
  </nav>

  <main id="main-content" class="lm-main">
    <nav class="lm-crumbs mono" aria-label="Breadcrumb">
      <ol>
        <li><a href="/loom/">LOOM</a></li>
        {%- if chapter %}
        <li><a href="/loom/manual/">MANUAL</a></li>
        <li aria-current="page">{{ chapter.title | upper }}</li>
        {%- else %}
        <li aria-current="page">MANUAL</li>
        {%- endif %}
      </ol>
    </nav>

    <details class="lm-mobile-toc">
      <summary class="mono">CHAPTERS</summary>
      <ol>
        {%- for c in chapters %}
        <li><a href="{{ c.url }}"{% if c.order == here %} aria-current="page"{% endif %}>{{ c.title }}</a></li>
        {%- endfor %}
      </ol>
    </details>

    <p class="lm-eyebrow mono">{% if chapter %}CHAPTER {{ chapter.order }} · {% endif %}LOOM {{ loomManual.version }} MANUAL</p>
    <h1>{{ title }}</h1>

    <article class="manual-prose">
      {{ content | safe }}
    </article>

    <nav class="lm-pn" aria-label="Previous and next chapter">
      {%- if prev %}
      <a href="{{ prev.url }}" rel="prev"><span class="k mono">PREVIOUS</span><span class="t">{{ prev.title }}</span></a>
      {%- endif %}
      {%- if next %}
      <a href="{{ next.url }}" rel="next" class="next"><span class="k mono">{% if chapter %}NEXT{% else %}START READING{% endif %}</span><span class="t">{{ next.title }}</span></a>
      {%- endif %}
    </nav>

    <aside class="lm-cta" aria-label="Get LOOM">
      <p>The same manual ships inside LOOM as a PDF, so it opens with no internet connection. Press ⌘/ in the app. LOOM is free to try for 14 days, with every feature unlocked.</p>
      <a href="/loom/#get" class="mono">TRY LOOM FREE</a>
    </aside>
  </main>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "{{ 'TechArticle' if chapter else 'CollectionPage' }}",
      "@id": "{{ site.url }}{{ page.url }}#page",
      "url": "{{ site.url }}{{ page.url }}",
      "name": {{ (seoTitle or title) | dump | safe }},
      {%- if chapter %}
      "headline": {{ title | dump | safe }},
      "proficiencyLevel": "Beginner",
      {%- endif %}
      "description": {{ description | dump | safe }},
      "inLanguage": "en",
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "about": { "@id": "{{ site.url }}/loom/#software" },
      "publisher": { "@id": "{{ site.url }}/#organization" },
      "author": { "@id": "{{ site.url }}/#organization" },
      "version": "{{ loomManual.version }}"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "LOOM", "item": "{{ site.url }}/loom/" },
        { "@type": "ListItem", "position": 2, "name": "Manual", "item": "{{ site.url }}/loom/manual/" }
        {%- if chapter %},
        { "@type": "ListItem", "position": 3, "name": {{ chapter.title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
        {%- endif %}
      ]
    }
  ]
}
</script>
