<script>
  // Reduce Motion: nothing plays on its own. The videos keep their controls, so they can still be started.
  (function () {
    var mq = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
    function apply() {
      if (!mq || !mq.matches) return;
      document.querySelectorAll('.l2-page video[autoplay]').forEach(function (v) {
        v.removeAttribute('autoplay'); v.autoplay = false; v.pause();
      });
    }
    apply();
    if (mq && mq.addEventListener) mq.addEventListener('change', apply);
  })();
</script>
