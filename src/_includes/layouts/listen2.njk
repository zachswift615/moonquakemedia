    <!-- Everyday listening -->
    <section style="max-width: 1200px; margin: 0 auto; padding: 88px 24px; display: flex; flex-direction: column; gap: 32px" aria-labelledby="l2-s9">
      <h2 id="l2-s9" style="margin: 0; font-size: clamp(30px, 3.5vw, 42px); line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; max-width: 760px">The small things that make a long book easier</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px">
        <div style="border: 1px solid #2A2A2D; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><h3 style="margin: 0; font-size: 19px; font-weight: 700">Away from the app</h3><p style="margin: 0; font-size: 16px; line-height: 1.55; color: #A3A3A0">Play, pause and skip from the lock screen, Control Center, AirPods, your car or your Apple Watch.</p></div>
        <div style="border: 1px solid #2A2A2D; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><h3 style="margin: 0; font-size: 19px; font-weight: 700">Sleep timer</h3><p style="margin: 0; font-size: 16px; line-height: 1.55; color: #A3A3A0">Stop after 15 to 60 minutes, or any time up to two hours, with an optional chime.</p></div>
        <div style="border: 1px solid #2A2A2D; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><h3 style="margin: 0; font-size: 19px; font-weight: 700">Find your place</h3><p style="margin: 0; font-size: 16px; line-height: 1.55; color: #A3A3A0">Bookmarks, search, the table of contents, and a Jump Back button for when you wander.</p></div>
        <div style="border: 1px solid #2A2A2D; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><h3 style="margin: 0; font-size: 19px; font-weight: 700">Collections</h3><p style="margin: 0; font-size: 16px; line-height: 1.55; color: #A3A3A0">Line up several documents to play in order, with spoken introductions between them, and share the set with a friend.</p></div>
        <div style="border: 1px solid #2A2A2D; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><h3 style="margin: 0; font-size: 19px; font-weight: 700">iCloud Sync</h3><p style="margin: 0; font-size: 16px; line-height: 1.55; color: #A3A3A0">Keep your library on your iPhone and iPad in step if you turn it on, or export a backup file instead.</p></div>
        <div style="border: 1px solid #2A2A2D; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 8px"><h3 style="margin: 0; font-size: 19px; font-weight: 700">Paragraph pauses</h3><p style="margin: 0; font-size: 16px; line-height: 1.55; color: #A3A3A0">Add up to a second of quiet between paragraphs so dense text has room to breathe.</p></div>
      </div>
      <div role="region" aria-label="App screenshots, scrolls sideways" tabindex="0" style="overflow-x: auto; padding-bottom: 8px">
        <div style="display: flex; gap: 20px; width: max-content">
          <div style="flex: 0 0 auto; width: 220px; max-width: 100%; aspect-ratio: 1320 / 2868; box-sizing: border-box; padding: 9px; border-radius: 48px; background: #1C1C1E; border: 1px solid #3A3A3D"><img loading="lazy" decoding="async" src="/assets/listen2/web/library-grid.webp" alt="The Listen2 library in grid view with classic book covers" style="display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 40px"></div>
          <div style="flex: 0 0 auto; width: 220px; max-width: 100%; aspect-ratio: 1320 / 2868; box-sizing: border-box; padding: 9px; border-radius: 48px; background: #1C1C1E; border: 1px solid #3A3A3D"><img loading="lazy" decoding="async" src="/assets/listen2/web/collection.webp" alt="The History of Love collection with a Play button, spoken intros and chapters" style="display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 40px"></div>
