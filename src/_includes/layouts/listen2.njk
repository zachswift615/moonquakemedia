<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do I need an internet connection?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Every voice runs on your iPhone, and the {{ listen2Voices.voiceCount }} Listen2 Voices come with the app, so you can listen offline from the start. You only need a connection to download more voices, import a web page or turn on iCloud Sync."
      }
    },
    {
      "@type": "Question",
      "name": "Which devices does it run on?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "iPhone and iPad running iOS 18.2 or later. The Listen2 Voices, Phonon, Supertonic and Apple's voices all work on any supported device. Listen2 picks the version of its own voice model that suits your device's memory."
      }
    },
    {
      "@type": "Question",
      "name": "Which languages are there?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Listen2 fully supports 13 languages: English, Spanish, Portuguese, Italian, French, German, Hungarian, Turkish, Swedish, Russian, Greek, Hindi and Vietnamese. In each of them, numbers, dates and abbreviations are read the way a person would say them, and every word is highlighted as it is spoken. Supertonic voices read all 13, and Phonon and the Listen2 Voices read English. Apple's voices can read nearly any other language your device supports."
      }
    },
    {
      "@type": "Question",
      "name": "Can I make a voice of someone else?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Only with them there. Whether you record in the app or start from an audio file, the person whose voice it is says one sentence aloud, and Listen2 checks that it is the same person. If they cannot say it, Listen2 does not make the voice."
      }
    },
    {
      "@type": "Question",
      "name": "Will a voice I make sound exactly like me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. It takes on the general character of the voice in your recording, but it is not an exact copy. You hear it read before you save it, and you can record again."
      }
    },
    {
      "@type": "Question",
      "name": "I used Voice Dream. Can I move my books over?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Listen2 opens the same kinds of files, including DAISY books from Bookshare, so you can import them from Files."
      }
    },
    {
      "@type": "Question",
      "name": "What happens after the 7-day trial?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your library stays where it is. To keep listening, you make the one-time purchase. If you already bought it, Restore Purchases in Settings brings it back on a new device."
      }
    }
  ]
}
</script>
