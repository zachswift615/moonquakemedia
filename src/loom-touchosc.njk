  .sc-pdf-body { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .sc-pdf h2 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
  .sc-pdf p { margin: 0; font-size: 15px; line-height: 1.5; color: #8A9099; }
