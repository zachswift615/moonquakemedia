  .sc-cap.sc-sym { font-family: -apple-system, "Helvetica Neue", sans-serif; font-size: 17px; }
  .sc-key-what { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  .sc-key-why { font-size: 14.5px; line-height: 1.5; color: #8A9099; margin-top: -8px; }

