---
# /loom/version — THE OTHER URL COMPILED INTO EVERY SHIPPED LOOM BINARY.
#
# `kLatestVersionUrl` at apps/loom_app/src/Main.cpp:960 is the literal string
# "https://moonquakemedia.com/loom/version", and a test at Main.cpp:29058 asserts it IS that and
# is the owner's own domain. Like /loom/buy, it can never be changed for a copy already sold.
#
# ⛔ THE CONTRACT IS "A HUMAN CAN READ A VERSION NUMBER OFF THIS PAGE", AND NOTHING MORE.
# LOOM opens this in the customer's browser and READS NOTHING BACK — there is no fetch, ever, and
# that absence is what keeps the product's "makes no network calls" claim true. So there is no
# JSON feed here and there must not be one: nothing would consume it, and shipping an endpoint
# that looks machine-readable invites somebody to make the app read it, which is the one thing
# LOOM's design refuses. A looper opened at a venue on captive-portal WiFi must have no code path
# that can hang, and the only way to guarantee that is to have no code.
#
# Self-contained for the same reason /loom/buy is: the two URLs the binary points at should not
# be able to break because a shared layout changed.
permalink: /loom/version/index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LOOM {{ releases.latest.version }} — latest version</title>
<meta name="description" content="The current version of LOOM for macOS, and every previous build.">
<style>
  /* ------------------------------------------------------------------
     Archivo and JetBrains Mono, self-hosted, copied VERBATIM from
     loom.njk's export so the two pages cannot drift in typeface. The
     duplication is deliberate: this URL is compiled into every shipped
     LOOM binary, and a page that renders through a shared include is a
     page a change elsewhere can break. Both are variable fonts, so one
     file covers 400-700. Licences sit beside them as *-OFL.txt.
     ⛔ Same rule as the licence page: no third-party font request. The
     design was exported with a fonts.googleapis.com <link> and it does
     not ship.
     ------------------------------------------------------------------ */
  @font-face {
    font-family: 'Archivo'; font-style: normal; font-weight: 400 700;
    font-stretch: 100%; font-display: swap;
    src: url('/assets/fonts/archivo-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Archivo'; font-style: normal; font-weight: 400 700;
    font-stretch: 100%; font-display: swap;
    src: url('/assets/fonts/archivo-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'JetBrains Mono'; font-style: normal; font-weight: 400 700; font-display: swap;
    src: url('/assets/fonts/jetbrains-mono-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'JetBrains Mono'; font-style: normal; font-weight: 400 700; font-display: swap;
    src: url('/assets/fonts/jetbrains-mono-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  /* loom.njk's own base rules and palette, so this page sits on the same ground. */
  :root{color-scheme:dark}
  html,body{margin:0;padding:0;background:#0B0C0E;color:#E8EAED;
    font-family:Archivo,"Helvetica Neue",Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:#4CC9F0;text-decoration:none}
  a:hover{color:#8AD9F5;text-decoration:underline}
  *:focus-visible{outline:2px solid #7FDBFF;outline-offset:2px}
  img{max-width:100%}

  main{max-width:720px;margin:0 auto;padding:72px 24px 96px;display:flex;flex-direction:column;gap:40px}
  .brand{display:flex;align-items:center;gap:11px}
  .brand img{width:30px;height:30px;border-radius:7px;display:block;flex:none}
  .brand span{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.13em;color:#C7CDD4}
  .eyebrow{font-family:'JetBrains Mono',monospace;font-size:12.5px;letter-spacing:0.2em;color:#8A9099;margin:0}
  h1{margin:0;font-size:clamp(38px,6vw,60px);font-weight:700;letter-spacing:-0.035em;line-height:1;text-wrap:balance}
  h2{margin:0 0 16px;font-size:15px;font-weight:600;letter-spacing:0.02em;color:#C7CDD4}
  p{margin:0;line-height:1.6;color:#8A9099;text-wrap:pretty}
  .row{display:flex;flex-wrap:wrap;align-items:center;gap:14px}
  .btn{display:inline-block;padding:15px 28px;border-radius:8px;background:#35D07F;color:#08090B;
    font-family:'JetBrains Mono',monospace;font-size:13.5px;font-weight:700;letter-spacing:0.09em}
  .btn:hover{color:#08090B;text-decoration:none;background:#48DC90}
  .meta{font-family:'JetBrains Mono',monospace;font-size:12px;line-height:1.6;color:#8A9099}
  .rule{height:1px;background:#1C1F24;border:0;margin:0}
  ul{list-style:none;margin:0;padding:0}
  li{display:flex;flex-wrap:wrap;gap:12px;align-items:baseline;padding:13px 0;border-bottom:1px solid #15181C}
  li:last-child{border-bottom:0}
  .v{font-family:'JetBrains Mono',monospace;font-size:13.5px;color:#E8EAED;min-width:6ch}
  .d{font-size:14px;color:#6B7078;flex:1}
  a.dl{font-family:'JetBrains Mono',monospace;font-size:12.5px;letter-spacing:0.06em;color:#35D07F}
  a.dl:hover{color:#48DC90}
  a.back{color:#8A9099;font-size:14px}
  a.back:hover{color:#E8EAED}
</style>
</head>
<body>
<main>

  <a class="brand" href="/loom/" style="text-decoration:none">
    <img src="/assets/loom/loom-icon.png" alt="">
    <span>LOOM</span>
  </a>

  <div style="display:flex;flex-direction:column;gap:18px">
    <p class="eyebrow">LOOM · LATEST VERSION</p>
    <h1>LOOM {{ releases.latest.version }}</h1>
    <p>Released {{ releases.latest.publishedOn }}. If the copy you are running shows
       an older number under <strong>LOOM &rsaquo; About LOOM</strong>, this is the one to download.</p>
  </div>

  <div class="row">
    <a class="btn" href="{{ releases.latestDmgUrl }}">DOWNLOAD LATEST &middot; {{ releases.latest.version }}</a>
    <span class="meta">{{ releases.latest.dmgSize }} &middot; macOS 13.3+<br>Apple silicon &middot; 14-day trial, every feature</span>
  </div>

  <hr class="rule">

  <div>
    <h2>Updating</h2>
    <p>Download, drag it into Applications, and replace the copy that is there. Your licence file
       is not touched — it lives outside the app, so an update never asks you to enter anything
       again.</p>
  </div>

  {% if releases.older.length %}
  <div>
    <h2>Previous builds</h2>
    <!-- ⭐ THE LIST SAYS, IN WORDS, THAT YOU DO NOT HAVE TO CHOOSE. A page listing several
         downloads makes a decision for the reader whether it means to or not, and the answer is
         the same for almost everybody. Saying so costs one sentence and removes the deliberation;
         the older builds stay reachable for the person who actually has a reason. -->
    <p style="margin:0 0 18px">Kept so an old build stays reachable at a permanent address. Unless
       you are pinning a specific version, <strong style="color:#C7CDD4">take the latest above</strong>
       — it is the one both download buttons on the LOOM page give you.</p>
    <ul>
      {% for r in releases.older %}
      <li>
        <span class="v">{{ r.version }}</span>
        <span class="d">{{ r.publishedOn }}</span>
        <a class="dl" href="{{ r.dmgUrl }}">DOWNLOAD{% if r.dmgSize %} &middot; {{ r.dmgSize }}{% endif %}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% else %}
  <div>
    <h2>Previous builds</h2>
    <p>None yet — {{ releases.latest.version }} is the first release. Older versions will be listed
       here with permanent download addresses as they are superseded.</p>
  </div>
  {% endif %}

  <hr class="rule">
  <p><a class="back" href="/loom/">&larr; Back to LOOM</a></p>

</main>
</body>
</html>
