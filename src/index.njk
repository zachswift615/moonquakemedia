---
title: Apps for Creators
description: "Moonquake Media builds local-first apps for Mac, iPhone and iPad, including LOOM, a live looper for Mac, and Listen2, an offline audiobook narrator."
layout: layouts/moonquake.njk
ogImage: /images/og-moonquake.png
ogImageWidth: 1200
ogImageHeight: 630
ogImageAlt: "The moonquake mark, a crescent moon whose shadow edge is a seismic trace, beside the lowercase moonquake wordmark on a near-black ground"
---
{#- The landing page. Nav, footer, fonts and colour tokens come from layouts/moonquake.njk. Each
    product keeps its own icon and type on its card. -#}
<style>
  /* Hero */
  .mq-hero { padding: 96px 0 80px; }
  .mq-hero h1 {
    margin: 24px 0 0; max-width: 820px;
    font-size: clamp(44px, 8vw, 80px); font-weight: 500; letter-spacing: -0.04em; line-height: 1.02;
    text-wrap: balance;
  }
  .mq-lede { margin: 24px 0 0; max-width: 560px; font-size: 18px; color: var(--mq-mist); text-wrap: pretty; }

  /* Apps */
  .mq-apps { padding: 0 0 96px; }
  .mq-apps-head { display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--mq-basalt); }
  .mq-grid { display: grid; grid-template-columns: 1fr; gap: 12px; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 640px) { .mq-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .mq-grid { grid-template-columns: repeat(3, 1fr); } }
  .mq-card {
    display: flex; flex-direction: column; gap: 14px; height: 100%; box-sizing: border-box;
    padding: 24px; border: 1px solid var(--mq-basalt); border-radius: 4px;
    color: var(--mq-regolith); transition: background-color .15s, border-color .15s;
  }
  .mq-card:hover { background: var(--mq-basalt); border-color: var(--mq-edge); text-decoration: none; }
  .mq-card img { width: 64px; height: 64px; border-radius: 22%; display: block; }
  .mq-card h2 { margin: 6px 0 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
  .mq-card p { margin: 0; flex: 1; font-size: 15px; color: var(--mq-mist); }
  .mq-card .mq-label { font-size: 12px; }

  @media (max-width: 639px) {
    .mq-hero { padding: 64px 0 56px; }
  }
</style>

<main id="main-content">
  <section class="mq-hero">
    <div class="mq-wrap">
      <div class="mq-label">{{ site.name }}</div>
      <h1>Tools for sound, speech and stage.</h1>
      <p class="mq-lede">{{ site.tagline }}, for Mac, iPhone and iPad.</p>
    </div>
  </section>

  <section class="mq-apps" id="apps" aria-labelledby="apps-heading">
    <div class="mq-wrap">
      <div class="mq-apps-head">
        <span class="mq-label" id="apps-heading">Apps</span>
        <span class="mq-label">{{ apps | length }}</span>
      </div>
      <ul class="mq-grid">
        {% for app in apps %}
        <li>
          {# `url` overrides the /apps/<slug>/ default. LOOM needs it: its page is at
             /loom/, not /apps/loom/, so without this its tile would 404. #}
          <a href="{{ app.url or ("/apps/" + app.slug + "/") }}" class="mq-card">
            <img src="{{ app.icon }}" alt="" width="64" height="64" loading="lazy">
            <h2{% if app.brandFont %} class="font-brand"{% endif %}>{{ app.name }}</h2>
            <p>{{ app.tagline }}</p>
            <span class="mq-label">{{ app.statusText }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
</main>
